---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

interface Props {
	title?: string;
	description?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title = 'TeamG Venturez', description = 'TeamG Venturez' } = Astro.props;
---

<!doctype html>
<html lang="en">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
	</head>
	<body>
		<Header />
		<main class="container">
			<slot />
		</main>
		<slot name="after" />
		<Footer />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Bricolage Grotesque';
		font-style: normal;
		font-weight: 400 800;
		font-display: swap;
		src: url('../assets/fonts/bricolage-grotesque-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122;
	}
	@font-face {
		font-family: 'Hanken Grotesk';
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
		src: url('../assets/fonts/hanken-grotesk-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122;
	}
	:root {
		color-scheme: light;
		--bg: #ffffff;
		--text: #0b1220;
		--muted: #46556a;
		--border: #d3dfec;
		--accent: #1d4ed8;
		--accent-strong: #1740b3;
		--tint: #e8f3ff;
		--display: 'Bricolage Grotesque', system-ui, sans-serif;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
		scrollbar-color: #9db4d3 var(--tint);
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--text);
		background: var(--bg);
		caret-color: var(--accent);
		overflow-x: clip;
	}
	main {
		flex: 1;
		padding-block: 2rem 3rem;
	}
	.container {
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}
	@media (min-width: 768px) {
		.container {
			padding-inline: 2rem;
		}
	}
	@media (min-width: 1280px) {
		.container {
			padding-inline: 3rem;
		}
	}
	::selection {
		background: var(--accent);
		color: #fff;
	}
	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}
	img {
		max-width: 100%;
		height: auto;
	}
	/* Shared inner-page structure */
	.page-head {
		padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
		max-width: 56rem;
	}
	.page-head h1 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
		text-wrap: balance;
		font-size: clamp(2.3rem, 6vw, 4.25rem);
		margin: 0 0 1.25rem;
	}
	.page-head p {
		color: var(--muted);
		font-size: 1.2rem;
		max-width: 56ch;
		margin: 0;
	}
	.band {
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		border-top: 1px solid var(--border);
	}
	.band h2 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
		font-size: clamp(1.7rem, 3.6vw, 2.6rem);
		margin: 0 0 1rem;
	}
	.band p {
		max-width: 62ch;
		margin: 0 0 1.25rem;
	}
	.split {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
		.split.flip > :first-child {
			order: 2;
		}
	}
	.photo {
		margin: 0;
	}
	.photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.9rem;
		box-shadow: 0 24px 48px -24px rgba(11, 18, 32, 0.35);
	}
	.photo figcaption {
		font-size: 0.85rem;
		color: var(--muted);
		margin-top: 0.6rem;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows > li {
		display: grid;
		gap: 0.5rem 3rem;
		padding-block: 1.75rem;
		border-top: 1px solid var(--border);
	}
	.rows > li:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.rows h3 {
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		line-height: 1.2;
		margin: 0;
	}
	.rows p {
		margin: 0;
		color: var(--muted);
		max-width: 60ch;
	}
	.rows a {
		display: inline-block;
		margin-top: 0.75rem;
		color: var(--accent);
		font-weight: 600;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}
	@media (min-width: 820px) {
		.rows > li {
			grid-template-columns: 1fr 1.4fr;
		}
	}
	.band a:not(.btn) {
		color: var(--accent);
		font-weight: 600;
	}
	.btn {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		padding: 0.95rem 1.6rem;
		border-radius: 0.6rem;
		border: 0;
		cursor: pointer;
		font-family: inherit;
		box-shadow: 0 6px 18px rgba(29, 78, 216, 0.28);
		transition:
			background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.btn:hover {
		background: var(--accent-strong);
		transform: translateY(-2px);
	}
	.closing {
		background: var(--accent);
		color: #fff;
		padding-block: clamp(3rem, 8vw, 5.5rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.closing h2 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		max-width: 24ch;
		margin: 0 0 1.5rem;
	}
	.closing .btn {
		background: #fff;
		color: var(--accent-strong);
		box-shadow: 0 8px 22px rgba(4, 12, 40, 0.3);
	}
	.closing .btn:hover {
		background: var(--tint);
	}
	.closing .btn:focus-visible {
		outline-color: #fff;
	}
</style>
