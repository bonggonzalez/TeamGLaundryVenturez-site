---
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';
import ContactBar from '../components/ContactBar.astro';
import { site } from '../config/site';

interface Props {
	title?: string;
	description?: string;
	image?: string;
}
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const { title = 'TeamG Venturez', description = 'TeamG Venturez is an authorized Samsung Professional Laundry dealer in Calabarzon, with a showroom in Alfonso, Cavite.', image = '/og.jpg' } = Astro.props;
const canonical = new URL(Astro.url.pathname, site.url).href;
const ogImage = new URL(`${base}${image}`, site.url).href;
// Only well-formed IDs are injected into inline scripts.
const gaId = /^G-[A-Z0-9]+$/.test(site.gaId) ? site.gaId : '';
const pixelId = /^\d{5,20}$/.test(site.metaPixelId) ? site.metaPixelId : '';
const orgSchema = {
	'@context': 'https://schema.org',
	'@type': 'Organization',
	name: site.name,
	url: site.url,
	logo: new URL(`${base}/og.jpg`, site.url).href,
	email: site.email,
	telephone: site.phoneIntl,
	description:
		'Authorized Samsung Professional Laundry dealer in Calabarzon. Design, construction, installation, maintenance and point-of-sale for laundry businesses.',
	address: {
		'@type': 'PostalAddress',
		streetAddress: site.address.street,
		addressLocality: site.address.locality,
		addressRegion: site.address.region,
		postalCode: site.address.postalCode,
		addressCountry: site.address.country,
	},
	areaServed: site.provinces.map((p) => ({ '@type': 'AdministrativeArea', name: `${p}, Philippines` })),
	...(site.facebook ? { sameAs: [site.facebook] } : {}),
};
---

<!doctype html>
<html lang="en-PH">
	<head>
		<meta charset="utf-8" />
		<meta name="viewport" content="width=device-width, initial-scale=1" />
		<meta name="description" content={description} />
		<link rel="icon" type="image/svg+xml" href={`${base}/favicon.svg`} />
		<link rel="icon" href={`${base}/favicon.ico`} />
		<meta name="generator" content={Astro.generator} />
		<title>{title}</title>
		<link rel="canonical" href={canonical} />
		<link rel="sitemap" href={`${base}/sitemap.xml`} />
		<meta property="og:type" content="website" />
		<meta property="og:site_name" content={site.name} />
		<meta property="og:locale" content="en_PH" />
		<meta property="og:title" content={title} />
		<meta property="og:description" content={description} />
		<meta property="og:url" content={canonical} />
		<meta property="og:image" content={ogImage} />
		<meta property="og:image:width" content="1200" />
		<meta property="og:image:height" content="630" />
		<meta name="twitter:card" content="summary_large_image" />
		<meta name="twitter:title" content={title} />
		<meta name="twitter:description" content={description} />
		<meta name="twitter:image" content={ogImage} />
		<script type="application/ld+json" set:html={JSON.stringify(orgSchema)} />
		<slot name="head" />
		<script is:inline>
			window.tgTrack = function (name, params) {
				try {
					if (window.gtag) window.gtag('event', name, params || {});
					if (window.fbq) {
						var m = { generate_lead: 'Lead', contact_click: 'Contact' }[name];
						if (m) window.fbq('track', m, params || {});
					}
				} catch (e) {}
			};
			document.addEventListener('click', function (e) {
				var a = e.target && e.target.closest ? e.target.closest('a') : null;
				if (!a) return;
				var h = a.getAttribute('href') || '';
				var t = a.getAttribute('data-track') || '';
				var method =
					t ||
					(h.indexOf('tel:') === 0 ? 'call' : h.indexOf('mailto:') === 0 ? 'email' : h.indexOf('viber:') === 0 ? 'viber' : h.indexOf('wa.me') > -1 ? 'whatsapp' : h.indexOf('m.me') > -1 ? 'messenger' : '');
				if (method && method !== 'quote') {
					window.tgTrack('contact_click', { method: method, page: location.pathname });
				} else if (method === 'quote' || a.classList.contains('btn') || a.classList.contains('cta')) {
					window.tgTrack('cta_click', { label: (a.textContent || '').trim(), page: location.pathname });
				}
			});
		</script>
		{gaId && <script async src={`https://www.googletagmanager.com/gtag/js?id=${gaId}`} is:inline />}
		{gaId && <script is:inline define:vars={{ gaId }}>window.dataLayer = window.dataLayer || []; window.gtag = function () { dataLayer.push(arguments); }; gtag('js', new Date()); gtag('config', gaId);</script>}
		{pixelId && <script is:inline define:vars={{ pixelId }}>!function(f,b,e,v,n,t,s){if(f.fbq)return;n=f.fbq=function(){n.callMethod?n.callMethod.apply(n,arguments):n.queue.push(arguments)};if(!f._fbq)f._fbq=n;n.push=n;n.loaded=!0;n.version='2.0';n.queue=[];t=b.createElement(e);t.async=!0;t.src=v;s=b.getElementsByTagName(e)[0];s.parentNode.insertBefore(t,s)}(window,document,'script','https://connect.facebook.net/en_US/fbevents.js');fbq('init', pixelId);fbq('track', 'PageView');</script>}
	</head>
	<body>
		<Header />
		<main class="container">
			<slot />
		</main>
		<slot name="after" />
		<Footer />
		<ContactBar />
	</body>
</html>

<style is:global>
	@font-face {
		font-family: 'Bricolage Grotesque';
		font-style: normal;
		font-weight: 400 800;
		font-display: swap;
		src: url('../assets/fonts/bricolage-grotesque-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122;
	}
	@font-face {
		font-family: 'Hanken Grotesk';
		font-style: normal;
		font-weight: 400 700;
		font-display: swap;
		src: url('../assets/fonts/hanken-grotesk-latin.woff2') format('woff2');
		unicode-range: U+0000-00FF, U+0131, U+0152-0153, U+02BB-02BC, U+02C6, U+02DA, U+02DC, U+2000-206F, U+20AC, U+2122;
	}
	:root {
		color-scheme: light;
		--bg: #ffffff;
		--text: #0b1220;
		--muted: #46556a;
		--border: #d3dfec;
		--accent: #1d4ed8;
		--accent-strong: #1740b3;
		--tint: #e8f3ff;
		--display: 'Bricolage Grotesque', system-ui, sans-serif;
	}
	*,
	*::before,
	*::after {
		box-sizing: border-box;
	}
	html {
		-webkit-text-size-adjust: 100%;
		scroll-behavior: smooth;
		scrollbar-color: #9db4d3 var(--tint);
	}
	@media (prefers-reduced-motion: reduce) {
		html {
			scroll-behavior: auto;
		}
	}
	body {
		margin: 0;
		min-height: 100vh;
		display: flex;
		flex-direction: column;
		font-family: 'Hanken Grotesk', system-ui, -apple-system, 'Segoe UI', sans-serif;
		font-size: 1.0625rem;
		line-height: 1.6;
		color: var(--text);
		background: var(--bg);
		caret-color: var(--accent);
		overflow-x: clip;
	}
	main {
		flex: 1;
		padding-block: 2rem 3rem;
	}
	.container {
		width: 100%;
		max-width: 76rem;
		margin-inline: auto;
		padding-inline: 1.25rem;
	}
	@media (min-width: 768px) {
		.container {
			padding-inline: 2rem;
		}
	}
	@media (min-width: 1280px) {
		.container {
			padding-inline: 3rem;
		}
	}
	::selection {
		background: var(--accent);
		color: #fff;
	}
	:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 3px;
		border-radius: 4px;
	}
	img {
		max-width: 100%;
		height: auto;
	}
	/* Shared inner-page structure */
	.page-head {
		padding-block: clamp(2rem, 6vw, 4.5rem) clamp(1.5rem, 4vw, 3rem);
		max-width: 56rem;
	}
	.page-head h1 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.04em;
		line-height: 1.02;
		text-wrap: balance;
		font-size: clamp(2.3rem, 6vw, 4.25rem);
		margin: 0 0 1.25rem;
	}
	.page-head p {
		color: var(--muted);
		font-size: 1.2rem;
		max-width: 56ch;
		margin: 0;
	}
	.band {
		padding-block: clamp(2.5rem, 6vw, 4.5rem);
		border-top: 1px solid var(--border);
	}
	.band h2 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
		font-size: clamp(1.7rem, 3.6vw, 2.6rem);
		margin: 0 0 1rem;
	}
	.band p {
		max-width: 62ch;
		margin: 0 0 1.25rem;
	}
	.split {
		display: grid;
		gap: 2rem;
		align-items: center;
	}
	@media (min-width: 900px) {
		.split {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
		.split.flip > :first-child {
			order: 2;
		}
	}
	.photo {
		margin: 0;
	}
	.photo img {
		display: block;
		width: 100%;
		height: auto;
		border-radius: 0.9rem;
		box-shadow: 0 24px 48px -24px rgba(11, 18, 32, 0.35);
	}
	.photo figcaption {
		font-size: 0.85rem;
		color: var(--muted);
		margin-top: 0.6rem;
	}
	.rows {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.rows > li {
		display: grid;
		gap: 0.5rem 3rem;
		padding-block: 1.75rem;
		border-top: 1px solid var(--border);
	}
	.rows > li:first-child {
		border-top: 0;
		padding-top: 0;
	}
	.rows h3 {
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		line-height: 1.2;
		margin: 0;
	}
	.rows p {
		margin: 0;
		color: var(--muted);
		max-width: 60ch;
	}
	.rows a {
		display: inline-block;
		margin-top: 0.75rem;
		color: var(--accent);
		font-weight: 600;
		text-decoration-thickness: 2px;
		text-underline-offset: 0.3em;
	}
	@media (min-width: 820px) {
		.rows > li {
			grid-template-columns: 1fr 1.4fr;
		}
	}
	.band a:not(.btn) {
		color: var(--accent);
		font-weight: 600;
	}
	.btn {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 1.05rem;
		text-decoration: none;
		padding: 0.95rem 1.6rem;
		border-radius: 0.6rem;
		border: 0;
		cursor: pointer;
		font-family: inherit;
		box-shadow: 0 6px 18px rgba(29, 78, 216, 0.28);
		transition:
			background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.btn:hover {
		background: var(--accent-strong);
		transform: translateY(-2px);
	}
	.closing {
		background: var(--accent);
		color: #fff;
		padding-block: clamp(3rem, 8vw, 5.5rem);
		margin-top: clamp(2.5rem, 6vw, 4.5rem);
	}
	.closing h2 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.03em;
		line-height: 1.08;
		text-wrap: balance;
		font-size: clamp(1.8rem, 4vw, 2.8rem);
		max-width: 24ch;
		margin: 0 0 1.5rem;
	}
	.closing .btn {
		background: #fff;
		color: var(--accent-strong);
		box-shadow: 0 8px 22px rgba(4, 12, 40, 0.3);
	}
	.closing .btn:hover {
		background: var(--tint);
	}
	.closing .btn:focus-visible {
		outline-color: #fff;
	}
</style>
