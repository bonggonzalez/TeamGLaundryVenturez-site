---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const services = [
	{
		title: 'Design',
		text: 'We plan the layout around your space, your volume and your customers, before anything is built.',
		cta: 'Ask about design',
	},
	{
		title: 'Construction',
		text: 'We plan the build-out together with the equipment, so the two fit from day one.',
		cta: 'Ask about construction',
	},
	{
		title: 'Equipment installation',
		text: 'Samsung professional equipment, installed by the team that supplies it.',
		cta: 'Ask about installation',
	},
	{
		title: 'Maintenance',
		text: 'Ongoing service after opening day, so your machines keep running.',
		cta: 'Ask about maintenance',
	},
	{
		title: 'Point-of-sale systems',
		text: 'Set up to take payment and track sales the way your laundry runs.',
		cta: 'Ask about point-of-sale',
	},
	{
		title: 'Business and marketing consultation',
		text: 'Practical advice on running and promoting your laundry.',
		cta: 'Ask about consultation',
	},
];
---

<Layout
	title="Laundry Design, Installation and Service | TeamG Venturez"
	description="Design, construction, equipment installation, maintenance, point-of-sale systems and business consultation for laundry shops and laundromats in Calabarzon."
>
	<header class="page-head">
		<h1>We look after your laundry from your first plan to long after opening day.</h1>
		<p>
			We handle your planning, construction, Samsung equipment, point-of-sale and ongoing support, so you have one team to turn to.
		</p>
	</header>

	<section class="band" aria-labelledby="what">
		<h2 id="what">How we can help your laundry</h2>
		<ul class="rows">
			{
				services.map((s) => (
					<li>
						<h3>{s.title}</h3>
						<div>
							<p>{s.text}</p>
							<a href={contact}>{s.cta}<span aria-hidden="true"> &rarr;</span></a>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<section class="band" aria-labelledby="inst">
		<h2 id="inst">What our basic installation covers</h2>
		<ul class="rows plain">
			<li><h3>Included</h3><div><p>Water supply and drainage connections. Electrical connections for the washer and dryer. Gas dryer connection and leak testing. Dryer exhaust and ducting. Testing, commissioning and basic training and handover.</p></div></li>
			<li><h3>Not included</h3><div><p>Civil works and structural changes. Major electrical upgrades. Building permits and government fees. The LPG tank, supply and regulator. Materials not listed in your quotation. Extra work found during installation is quoted separately and needs your approval first.</p></div></li>
			<li><h3>Optional utility additions</h3><div><p>Basic electrical, plumbing and ducting work needed to commission the equipment, from about ₱200,000. This is an estimate only and is confirmed after our site visit.</p></div></li>
		</ul>
		<p class="est">Prices, scope and timelines are estimates only. TeamG Venturez may change them without prior notice, and your signed scope of work confirms the final figures.</p>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="svc-start">
			<div class="container">
				<h2 id="svc-start">Starting, upgrading or adding laundry to your property? Tell us your plan.</h2>
				<a class="btn" href={contact}>Get a quote</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.wide :global(img) {
		aspect-ratio: 21 / 9;
		object-fit: cover;
		object-position: 70% 50%;
	}
	.est {
		margin-top: 1.5rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
