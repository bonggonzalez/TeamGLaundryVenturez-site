---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import laundromat from '../assets/images/laundromat.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const services = [
	{
		title: 'Design',
		text: 'We plan the layout around your space, your volume and your customers. Before anything is built.',
		cta: 'Ask about design',
	},
	{
		title: 'Construction',
		text: 'We plan the build-out together with the equipment. The two fit from day one.',
		cta: 'Ask about construction',
	},
	{
		title: 'Equipment installation',
		text: 'Samsung professional equipment, installed by the team that distributes it.',
		cta: 'Ask about installation',
	},
	{
		title: 'Maintenance',
		text: 'Ongoing service after opening day. Your machines stay in work.',
		cta: 'Ask about maintenance',
	},
	{
		title: 'Point-of-sale systems',
		text: 'Set up to take payment and track sales the way your laundry runs.',
		cta: 'Ask about point-of-sale',
	},
	{
		title: 'Business and marketing consultation',
		text: 'Practical guidance on running and promoting your laundry.',
		cta: 'Ask about consultation',
	},
];
---

<Layout
	title="Services | TeamG Venturez"
	description="Design, construction, equipment installation, maintenance, point-of-sale systems and business consultation for commercial laundry operations in Calabarzon."
>
	<header class="page-head">
		<h1>One team from first plan to first service.</h1>
		<p>
			Planning, construction, Samsung equipment, point-of-sale and ongoing support. All from TeamG.
		</p>
	</header>

	<figure class="photo wide">
		<Image
			src={laundromat}
			alt="Samsung professional washers and dryers stacked in a laundry shop"
			widths={[640, 960, 1280]}
			sizes="(min-width: 76rem) 70rem, 92vw"
		/>
		<figcaption>Image shown for illustration.</figcaption>
	</figure>

	<section class="band" aria-labelledby="what">
		<h2 id="what">Everything your laundry needs.</h2>
		<ul class="rows">
			{
				services.map((s) => (
					<li>
						<h3>{s.title}</h3>
						<div>
							<p>{s.text}</p>
							<a href={contact}>{s.cta}<span aria-hidden="true"> &rarr;</span></a>
						</div>
					</li>
				))
			}
		</ul>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="svc-start">
			<div class="container">
				<h2 id="svc-start">Starting, upgrading or adding laundry to your property? Tell us your plan.</h2>
				<a class="btn" href={contact}>Request a consultation</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.wide :global(img) {
		aspect-ratio: 21 / 9;
		object-fit: cover;
		object-position: 70% 50%;
	}
</style>
