---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import stackRow from '../assets/images/stack-row.jpg';
import samsung from '../assets/images/samsung-logo.png';
import { site } from '../config/site';
import MapLink from '../components/MapLink.astro';
import BannerCarousel from '../components/BannerCarousel.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const provinces = ['Cavite', 'Laguna', 'Batangas', 'Rizal', 'Quezon'];
const scope = [
	{ title: 'Design', text: 'A layout planned around your space, your volume and your customers.' },
	{ title: 'Construction', text: 'The build-out of your space, planned together with the equipment.' },
	{ title: 'Installation', text: 'Samsung professional equipment, installed by our own team.' },
	{ title: 'Maintenance', text: 'Ongoing service, so your laundry keeps running well after opening day.' },
	{ title: 'Point-of-sale systems', text: 'Payment and sales tracking, set up for how your laundry works.' },
	{ title: 'Business and marketing consultation', text: 'Practical advice on running and promoting your business.' },
];
const audiences = [
	{ key: 'start', cta: 'Compare startup packages', href: `${base}/packages`, title: 'Starting a laundry business', text: 'Turn your idea into a laundry negosyo with one partner for the plan, the build and the machines.' },
	{ key: 'upgrade', cta: 'Plan my upgrade', href: `${contact}?for=upgrade`, title: 'Upgrading your laundry', text: 'Replace or add equipment, and make the rest of your operation run more smoothly.' },
	{ key: 'hotel', cta: 'Plan an in-house laundry', href: `${contact}?for=hotel`, title: 'Hotel or BnB laundry', text: 'Run your own laundry inside your hotel, BnB or inn.' },
];
---
<Layout
	title="Samsung Laundry Equipment in Calabarzon | TeamG Venturez"
	description="Authorized Samsung laundry equipment dealer in Calabarzon. Start or upgrade your laundry shop with one team for design, build, installation and service."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<h1 id="hero-title">Authorized Samsung laundry equipment dealer in Calabarzon.</h1>
				<p class="lede">
					One team you can call for your layout, build, machines and service, from your first plan to your opening day. Your site visit and layout assessment are free, with no obligation.
				</p>
				<div class="actions">
					<a class="btn" href={contact}>Get a quote</a>
					<a class="link" href={`${base}/packages`}>Compare startup packages</a>
<a class="link" href={`${contact}?for=upgrade`}>Explore equipment upgrades</a>
				</div>
			</div>
			<figure class="machines">
				<Image
					src={stackRow}
					alt="Rows of black Samsung professional washers and dryers stacked in pairs"
					widths={[480, 720, 1000]}
					sizes="(min-width: 960px) 40vw, 90vw"
					loading="eager"
				/>
				<figcaption>Samsung professional washers and dryers, stacked in pairs. Image shown for illustration.</figcaption>
			</figure>
		</div>
	</section>

	<BannerCarousel />

	<section class="claim" aria-labelledby="claim-title">
		<div class="container claim-grid">
			<h2 id="claim-title">Buy Samsung laundry equipment in Calabarzon directly from us.</h2>
			<div>
				<Image class="sam" src={samsung} alt="Samsung Professional Laundry" height={80} />
				<p>
					As an authorized Samsung dealer, we sell you the machines, install them and keep them running, so you always have one team to call.
				</p>
				<ul class="provinces" aria-label="Provinces covered">
					{provinces.map((p) => <li>{p}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="scope" id="scope" aria-labelledby="scope-title">
		<div class="container scope-grid">
			<div class="scope-head">
				<h2 id="scope-title">Everything you need to open and run your laundry, from one team.</h2>
				<p>We do more than deliver machines. We help you build the whole laundry around them.</p>
			</div>
			<ol class="scope-list">
				{
					scope.map((s) => (
						<li>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="audiences" aria-labelledby="why-title">
		<div class="container">
			<h2 id="why-title">Why Samsung Professional Laundry</h2>
			<ul class="aud-list">
				<li>
					<h3>Built for daily loads</h3>
					<p>Main parts are tested to 30,000 cycles.</p>
				</li>
				<li>
					<h3>Made to last</h3>
					<p>An inverter direct-drive motor and a stainless steel drum.</p>
				</li>
				<li>
					<h3>Supported by us</h3>
					<p>We handle your site visit, layout, installation, training and after-sales service.</p>
				</li>
			</ul>
		</div>
	</section>

	<section class="audiences" aria-labelledby="aud-title">
		<div class="container">
			<h2 id="aud-title">Which of these describes you?</h2>
			<ul class="aud-list">
				{
					audiences.map((a) => (
						<li>
							<h3>{a.title}</h3>
							<p>{a.text}</p>
							<a href={a.href}>{a.cta}<span aria-hidden="true"> &rarr;</span></a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="audiences" aria-labelledby="show-title">
<div class="container">
<h2 id="show-title">See the machines at our showroom</h2>
<ul class="aud-list">
<li>
<h3>Visit us in Alfonso, Cavite</h3>
<p>{site.showroomName}, {site.addressDisplay}. See the Samsung machines in person and talk to us about your plan.</p>
					<p class="map"><MapLink /></p>
<a href={`${contact}?for=showroom`}>Request a showroom demo<span aria-hidden="true"> &rarr;</span></a>
</li>
<li>
<h3>Already our customer?</h3>
<p>Warranty claims, repairs and service go through us. Your equipment has a 2-year warranty with free preventive maintenance.</p>
<a href={`${contact}?for=service`}>Request service<span aria-hidden="true"> &rarr;</span></a>
</li>
</ul>
</div>
</section>

<section class="close" aria-labelledby="close-title">
		<div class="container close-inner">
			<h2 id="close-title">Let’s plan your laundry together. We supply the machines and stay with you after they are installed.</h2>
			<a class="btn on-dark" href={contact}>Get a quote</a>
			<p class="visit">Visit our showroom at {site.showroomName}: {site.addressDisplay}.</p>
			<p class="visit"><MapLink onDark /></p>
		</div>
	</section>
</Layout>

<style is:global>
	main.container {
		max-width: none;
		padding: 0;
	}
</style>
<style>
	h1,
	h2,
	h3 {
		font-family: var(--display);
		letter-spacing: -0.03em;
		line-height: 1.12;
		text-wrap: balance;
		margin: 0;
	}
	section {
		padding-block: clamp(3.5rem, 9vw, 7rem);
	}
	.btn {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 1.1rem;
		text-decoration: none;
		padding: 1rem 1.75rem;
		border-radius: 0.6rem;
		box-shadow: 0 6px 18px rgba(29, 78, 216, 0.28);
		transition:
			background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.btn:hover {
		background: var(--accent-strong);
		transform: translateY(-2px);
	}
	.btn.on-dark {
		background: #fff;
		color: var(--accent-strong);
		box-shadow: 0 8px 22px rgba(4, 12, 40, 0.3);
	}
	.btn.on-dark:hover {
		background: var(--tint);
	}
	.btn.on-dark:focus-visible {
		outline-color: #fff;
	}
	/* Hero */
	.hero {
		background: linear-gradient(#ffffff, var(--tint));
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 8vw, 6rem);
		min-height: calc(100svh - 4.5rem);
		display: grid;
		align-items: center;
	}
	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	h1 {
		font-weight: 800;
		font-size: clamp(2.5rem, 6.5vw, 4.25rem);
		line-height: 1;
		letter-spacing: -0.04em;
		margin-bottom: 1.5rem;
	}
	.lede {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		color: var(--muted);
		max-width: 34rem;
		margin: 0 0 2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
	}
	.link {
		color: var(--text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}
	.link:hover {
		color: var(--accent-strong);
	}
	.machines {
		margin: 0;
	}
	.machines img {
		display: block;
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
		height: auto;
		border-radius: 0.9rem;
		box-shadow: 0 24px 48px -24px rgba(11, 18, 32, 0.35);
	}
	.machines figcaption {
		text-align: center;
		font-size: 0.85rem;
		color: var(--muted);
		margin-top: 0.5rem;
	}
	@media (min-width: 960px) {
		.hero-grid {
			grid-template-columns: 1.15fr 1fr;
			gap: 3rem;
		}
	}
	/* Claim */
	.claim h2 {
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		line-height: 1.04;
		font-weight: 800;
	}
	.claim-grid {
		display: grid;
		gap: 1.75rem;
	}
	.claim p {
		font-size: 1.2rem;
		max-width: 38rem;
		margin: 0 0 1.5rem;
		color: var(--muted);
	}
	.provinces {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--display);
		font-weight: 700;
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
		letter-spacing: -0.02em;
	}
	.provinces li:not(:last-child)::after {
		content: '\00b7';
		margin-inline: 0.6em;
		color: var(--accent);
	}
	@media (min-width: 960px) {
		.claim-grid {
			grid-template-columns: 1.1fr 1fr;
			gap: 4rem;
			align-items: start;
		}
	}
	/* Scope */
	.scope {
		border-top: 1px solid var(--border);
	}
	.scope-grid {
		display: grid;
		gap: 2.5rem;
	}
	.scope-head h2 {
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.05;
		font-weight: 800;
		margin-bottom: 1rem;
	}
	.scope-head p {
		color: var(--muted);
		max-width: 28rem;
		margin: 0;
	}
	.scope-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.scope-list li {
		display: grid;
		gap: 0.25rem 2rem;
		padding-block: 1.4rem;
		border-top: 1px solid var(--border);
	}
	.scope-list li:last-child {
		border-bottom: 1px solid var(--border);
	}
	.scope-list h3 {
		font-size: 1.4rem;
		font-weight: 700;
	}
	.scope-list p {
		margin: 0;
		color: var(--muted);
		max-width: 38rem;
	}
	@media (min-width: 768px) {
		.scope-list li {
			grid-template-columns: 15rem 1fr;
			align-items: baseline;
		}
	}
	@media (min-width: 1024px) {
		.scope-grid {
			grid-template-columns: 22rem 1fr;
			gap: 4rem;
		}
		.scope-head {
			position: sticky;
			top: 6rem;
			align-self: start;
		}
	}
	/* Audiences */
	.audiences {
		background: var(--tint);
	}
	.audiences h2 {
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.05;
		font-weight: 800;
		margin-bottom: 2.5rem;
		max-width: 40rem;
	}
	.aud-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		border-top: 1.5px solid var(--text);
	}
	.aud-list li {
		display: flex;
		flex-direction: column;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.aud-list h3 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 0.6rem;
	}
	.aud-list p {
		margin: 0 0 1rem;
		color: var(--muted);
		max-width: 28rem;
	}
	.aud-list a {
		margin-top: auto;
		font-weight: 600;
		color: var(--accent-strong);
		text-underline-offset: 0.3em;
	}
	@media (min-width: 860px) {
		.aud-list {
			grid-template-columns: repeat(3, 1fr);
		}
		.aud-list li {
			padding: 1.75rem 2rem 1.75rem 0;
			border-bottom: 0;
		}
		.aud-list li + li {
			padding-left: 2rem;
			border-left: 1px solid var(--border);
		}
	}
	/* Close */
	.visit {
		margin: 0;
		opacity: 0.9;
	}
	.close {
		position: relative;
		overflow: hidden;
		background: var(--navy);
		color: #fff;
	}
	.close-inner {
		display: grid;
		gap: 2rem;
		justify-items: start;
	}
	.close h2 {
		font-size: clamp(2rem, 5vw, 3.75rem);
		line-height: 1.04;
		font-weight: 800;
		max-width: 50rem;
	}
	.claim :global(.sam) {
		display: block;
		height: 2.75rem;
		width: auto;
		margin-bottom: 1.25rem;
		mix-blend-mode: multiply;
	}
</style>
