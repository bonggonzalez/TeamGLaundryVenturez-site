---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const provinces = ['Cavite', 'Laguna', 'Batangas', 'Rizal', 'Quezon'];
const scope = [
	{ title: 'Design', text: 'A laundry layout planned around your space, your volume and your customers.' },
	{ title: 'Construction', text: 'The build-out of the premises, handled alongside the equipment plan.' },
	{ title: 'Installation', text: 'Samsung professional equipment installed and commissioned by the people who sell it.' },
	{ title: 'Maintenance', text: 'Ongoing service so the operation keeps earning after opening day.' },
	{ title: 'Point of sale', text: 'Point-of-sale systems set up for how your laundry takes payment.' },
	{ title: 'Business and marketing consultation', text: 'Practical guidance on running and promoting the business.' },
];
const audiences = [
	{ key: 'start', title: 'Starting a laundry business', text: 'Go from idea to opening with one partner for the plan, the build and the machines.' },
	{ key: 'upgrade', title: 'Upgrading your laundry', text: 'Replace or expand your equipment and add the systems around it.' },
	{ key: 'hotel', title: 'Running laundry in your hotel or motel', text: 'Set up an in-house laundry operation inside your property.' },
];
---
<Layout
	title="Team G Laundry Venturez | Exclusive Samsung laundry equipment distributor in Calabarzon"
	description="Team G Laundry Venturez is the exclusive Samsung laundry equipment distributor in Calabarzon. We design, build, install and maintain laundry operations."
>
	<section class="hero" aria-labelledby="hero-title">
		<div class="container hero-grid">
			<div class="hero-copy">
				<h1 id="hero-title">The only Samsung laundry equipment distributor in Calabarzon.</h1>
				<p class="lede">
					One partner to design, build, equip and maintain your laundry operation, from the first
					plan to point of sale.
				</p>
				<div class="actions">
					<a class="btn" href={contact}>Request a consultation</a>
					<a class="link" href="#scope">See what we build</a>
				</div>
			</div>
			<figure class="machines">
				<svg viewBox="0 0 560 480" role="img" aria-label="Illustration of a commercial washer and dryer with stainless steel drums">
					<defs>
						<linearGradient id="body" x1="0" y1="0" x2="0" y2="1">
							<stop offset="0" stop-color="#ffffff" />
							<stop offset="1" stop-color="#d5e2f1" />
						</linearGradient>
						<radialGradient id="steel" cx="0.4" cy="0.35" r="0.85">
							<stop offset="0" stop-color="#f6f9fc" />
							<stop offset="0.6" stop-color="#b3c3d6" />
							<stop offset="1" stop-color="#7c90a8" />
						</radialGradient>
						<radialGradient id="glass" cx="0.3" cy="0.25" r="0.95">
							<stop offset="0" stop-color="#a9cdf0" stop-opacity="0.5" />
							<stop offset="1" stop-color="#0b1220" stop-opacity="0.7" />
						</radialGradient>
					</defs>
					<ellipse cx="280" cy="462" rx="262" ry="12" fill="#0b1220" opacity="0.12" />
					<g>
						<rect x="30" y="436" width="230" height="14" rx="4" fill="#9db4d3" />
						<rect x="20" y="40" width="250" height="400" rx="22" fill="url(#body)" stroke="#a9bdd4" stroke-width="2" />
						<rect x="44" y="62" width="202" height="46" rx="10" fill="#0b1220" />
						<circle cx="70" cy="85" r="8" fill="#1d4ed8" />
						<rect x="92" y="78" width="90" height="14" rx="7" fill="#46556a" />
						<circle cx="214" cy="85" r="12" fill="#c8d6e6" />
						<circle cx="145" cy="270" r="108" fill="#2b3a4f" />
						<circle cx="145" cy="270" r="96" fill="#c3d2e3" stroke="#8ea3bd" stroke-width="3" />
						<circle cx="145" cy="270" r="84" fill="url(#steel)" />
						<g class="drum" fill="none" stroke="#5b7089" stroke-linecap="round">
							<circle cx="145" cy="270" r="68" stroke-width="5" stroke-dasharray="0.1 10" />
							<circle cx="145" cy="270" r="52" stroke-width="5" stroke-dasharray="0.1 10" />
							<circle cx="145" cy="270" r="36" stroke-width="5" stroke-dasharray="0.1 9" />
							<circle cx="145" cy="270" r="20" stroke-width="5" stroke-dasharray="0.1 8" />
						</g>
						<circle cx="145" cy="270" r="84" fill="url(#glass)" />
						<ellipse cx="114" cy="230" rx="24" ry="11" fill="#fff" opacity="0.4" transform="rotate(-32 114 230)" />
					</g>
					<g>
						<rect x="300" y="436" width="230" height="14" rx="4" fill="#9db4d3" />
						<rect x="290" y="40" width="250" height="400" rx="22" fill="url(#body)" stroke="#a9bdd4" stroke-width="2" />
						<rect x="314" y="62" width="202" height="46" rx="10" fill="#0b1220" />
						<rect x="334" y="76" width="60" height="18" rx="4" fill="#46556a" />
						<circle cx="440" cy="85" r="10" fill="#1d4ed8" />
						<circle cx="480" cy="85" r="10" fill="#c8d6e6" />
						<circle cx="415" cy="262" r="100" fill="#dfe9f4" stroke="#8ea3bd" stroke-width="6" />
						<circle cx="415" cy="262" r="86" fill="url(#steel)" />
						<g class="drum slow" fill="none" stroke="#5b7089" stroke-linecap="round">
							<circle cx="415" cy="262" r="70" stroke-width="5" stroke-dasharray="0.1 10" />
							<circle cx="415" cy="262" r="54" stroke-width="5" stroke-dasharray="0.1 10" />
							<circle cx="415" cy="262" r="38" stroke-width="5" stroke-dasharray="0.1 9" />
							<circle cx="415" cy="262" r="22" stroke-width="5" stroke-dasharray="0.1 8" />
						</g>
						<circle cx="415" cy="262" r="86" fill="url(#glass)" />
						<ellipse cx="384" cy="224" rx="24" ry="11" fill="#fff" opacity="0.4" transform="rotate(-32 384 224)" />
						<g fill="#9db4d3">
							<rect x="350" y="392" width="130" height="5" rx="2.5" />
							<rect x="350" y="404" width="130" height="5" rx="2.5" />
							<rect x="350" y="416" width="130" height="5" rx="2.5" />
						</g>
					</g>
				</svg>
				<figcaption>Samsung professional washer and dryer, shown as an illustration.</figcaption>
			</figure>
		</div>
	</section>

	<section class="claim" aria-labelledby="claim-title">
		<div class="container claim-grid">
			<h2 id="claim-title">One distributor holds Calabarzon. It is Team G.</h2>
			<div>
				<p>
					Samsung laundry equipment reaches Calabarzon through a single exclusive distributor, so
					buying, installation and service all come from the same team.
				</p>
				<ul class="provinces" aria-label="Provinces covered">
					{provinces.map((p) => <li>{p}</li>)}
				</ul>
			</div>
		</div>
	</section>

	<section class="scope" id="scope" aria-labelledby="scope-title">
		<div class="container scope-grid">
			<div class="scope-head">
				<h2 id="scope-title">From the first plan to the first service call.</h2>
				<p>We do not stop at delivering machines. Everything your laundry needs to open and keep running is in one team.</p>
			</div>
			<ol class="scope-list">
				{
					scope.map((s) => (
						<li>
							<h3>{s.title}</h3>
							<p>{s.text}</p>
						</li>
					))
				}
			</ol>
		</div>
	</section>

	<section class="audiences" aria-labelledby="aud-title">
		<div class="container">
			<h2 id="aud-title">Built around where you are starting from.</h2>
			<ul class="aud-list">
				{
					audiences.map((a) => (
						<li>
							<h3>{a.title}</h3>
							<p>{a.text}</p>
							<a href={`${contact}?for=${a.key}`}>Talk to Team G<span aria-hidden="true"> &rarr;</span></a>
						</li>
					))
				}
			</ul>
		</div>
	</section>

	<section class="close" aria-labelledby="close-title">
		<div class="container close-inner">
			<h2 id="close-title">Plan your laundry operation with the team that supplies the machines.</h2>
			<a class="btn on-dark" href={contact}>Request a consultation</a>
		</div>
	</section>
</Layout>

<style is:global>
	main.container {
		max-width: none;
		padding: 0;
	}
</style>
<style>
	h1,
	h2,
	h3 {
		font-family: var(--display);
		letter-spacing: -0.03em;
		line-height: 1.12;
		text-wrap: balance;
		margin: 0;
	}
	section {
		padding-block: clamp(3.5rem, 9vw, 7rem);
	}
	.btn {
		display: inline-block;
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 1.1rem;
		text-decoration: none;
		padding: 1rem 1.75rem;
		border-radius: 0.6rem;
		box-shadow: 0 6px 18px rgba(29, 78, 216, 0.28);
		transition:
			background 0.25s cubic-bezier(0.16, 1, 0.3, 1),
			transform 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.btn:hover {
		background: var(--accent-strong);
		transform: translateY(-2px);
	}
	.btn.on-dark {
		background: #fff;
		color: var(--accent-strong);
		box-shadow: 0 8px 22px rgba(4, 12, 40, 0.3);
	}
	.btn.on-dark:hover {
		background: var(--tint);
	}
	.btn.on-dark:focus-visible {
		outline-color: #fff;
	}
	/* Hero */
	.hero {
		background: linear-gradient(#ffffff, var(--tint));
		padding-block: clamp(2.5rem, 7vw, 5rem) clamp(3rem, 8vw, 6rem);
		min-height: calc(100svh - 4.5rem);
		display: grid;
		align-items: center;
	}
	.hero-grid {
		display: grid;
		gap: 2.5rem;
		align-items: center;
	}
	h1 {
		font-weight: 800;
		font-size: clamp(2.5rem, 6.5vw, 4.25rem);
		line-height: 1;
		letter-spacing: -0.04em;
		margin-bottom: 1.5rem;
	}
	.lede {
		font-size: clamp(1.1rem, 2vw, 1.35rem);
		color: var(--muted);
		max-width: 34rem;
		margin: 0 0 2rem;
	}
	.actions {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 1rem 1.75rem;
	}
	.link {
		color: var(--text);
		font-weight: 600;
		text-decoration: underline;
		text-decoration-color: var(--accent);
		text-decoration-thickness: 2px;
		text-underline-offset: 0.35em;
	}
	.link:hover {
		color: var(--accent-strong);
	}
	.machines {
		margin: 0;
	}
	.machines svg {
		display: block;
		width: 100%;
		max-width: 36rem;
		margin-inline: auto;
	}
	.machines figcaption {
		text-align: center;
		font-size: 0.85rem;
		color: var(--muted);
		margin-top: 0.5rem;
	}
	.drum {
		transform-box: fill-box;
		transform-origin: center;
	}
	@media (prefers-reduced-motion: no-preference) {
		@keyframes spin {
			to {
				rotate: 360deg;
			}
		}
		.drum {
			animation: spin 14s linear infinite;
		}
		.drum.slow {
			animation-duration: 22s;
			animation-direction: reverse;
		}
	}
	@media (min-width: 960px) {
		.hero-grid {
			grid-template-columns: 1.15fr 1fr;
			gap: 3rem;
		}
	}
	/* Claim */
	.claim h2 {
		font-size: clamp(2rem, 4.5vw, 3.5rem);
		line-height: 1.04;
		font-weight: 800;
	}
	.claim-grid {
		display: grid;
		gap: 1.75rem;
	}
	.claim p {
		font-size: 1.2rem;
		max-width: 38rem;
		margin: 0 0 1.5rem;
		color: var(--muted);
	}
	.provinces {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 0;
		list-style: none;
		margin: 0;
		padding: 0;
		font-family: var(--display);
		font-weight: 700;
		font-size: clamp(1.25rem, 2.4vw, 1.75rem);
		letter-spacing: -0.02em;
	}
	.provinces li:not(:last-child)::after {
		content: '\00b7';
		margin-inline: 0.6em;
		color: var(--accent);
	}
	@media (min-width: 960px) {
		.claim-grid {
			grid-template-columns: 1.1fr 1fr;
			gap: 4rem;
			align-items: start;
		}
	}
	/* Scope */
	.scope {
		border-top: 1px solid var(--border);
	}
	.scope-grid {
		display: grid;
		gap: 2.5rem;
	}
	.scope-head h2 {
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.05;
		font-weight: 800;
		margin-bottom: 1rem;
	}
	.scope-head p {
		color: var(--muted);
		max-width: 28rem;
		margin: 0;
	}
	.scope-list {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	.scope-list li {
		display: grid;
		gap: 0.25rem 2rem;
		padding-block: 1.4rem;
		border-top: 1px solid var(--border);
	}
	.scope-list li:last-child {
		border-bottom: 1px solid var(--border);
	}
	.scope-list h3 {
		font-size: 1.4rem;
		font-weight: 700;
	}
	.scope-list p {
		margin: 0;
		color: var(--muted);
		max-width: 38rem;
	}
	@media (min-width: 768px) {
		.scope-list li {
			grid-template-columns: 15rem 1fr;
			align-items: baseline;
		}
	}
	@media (min-width: 1024px) {
		.scope-grid {
			grid-template-columns: 22rem 1fr;
			gap: 4rem;
		}
		.scope-head {
			position: sticky;
			top: 6rem;
			align-self: start;
		}
	}
	/* Audiences */
	.audiences {
		background: var(--tint);
	}
	.audiences h2 {
		font-size: clamp(1.9rem, 4vw, 3rem);
		line-height: 1.05;
		font-weight: 800;
		margin-bottom: 2.5rem;
		max-width: 40rem;
	}
	.aud-list {
		list-style: none;
		margin: 0;
		padding: 0;
		display: grid;
		border-top: 1.5px solid var(--text);
	}
	.aud-list li {
		display: flex;
		flex-direction: column;
		padding-block: 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.aud-list h3 {
		font-size: 1.5rem;
		font-weight: 700;
		margin-bottom: 0.6rem;
	}
	.aud-list p {
		margin: 0 0 1rem;
		color: var(--muted);
		max-width: 28rem;
	}
	.aud-list a {
		margin-top: auto;
		font-weight: 600;
		color: var(--accent-strong);
		text-underline-offset: 0.3em;
	}
	@media (min-width: 860px) {
		.aud-list {
			grid-template-columns: repeat(3, 1fr);
		}
		.aud-list li {
			padding: 1.75rem 2rem 1.75rem 0;
			border-bottom: 0;
		}
		.aud-list li + li {
			padding-left: 2rem;
			border-left: 1px solid var(--border);
		}
	}
	/* Close */
	.close {
		background: var(--accent);
		color: #fff;
	}
	.close-inner {
		display: grid;
		gap: 2rem;
		justify-items: start;
	}
	.close h2 {
		font-size: clamp(2rem, 5vw, 3.75rem);
		line-height: 1.04;
		font-weight: 800;
		max-width: 50rem;
	}
</style>
