---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import washer from '../assets/images/washer.jpg';
import dryer from '../assets/images/dryer.jpg';
import stackRow from '../assets/images/stack-row.jpg';
import samsung from '../assets/images/samsung-logo.png';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const why = [
	{ title: 'Built for daily loads', text: 'Commercial laundries run machines all day. This equipment is made for that workload.' },
	{ title: 'Tested to 30,000 cycles', text: 'Main parts are tested for 30,000 cycles. An inverter direct-drive motor drives the drum.' },
	{ title: 'Know your daily capacity', text: 'An 18 kg washer runs a 36 minute cycle and a 14 kg dryer runs 45 minutes. That lets you estimate how many loads your shop can handle in a day.' },
];
const features = [
	{ title: 'Powerful, effective cleaning', text: 'Bubble Wash turns detergent into rich bubbles that soak quickly into fabric. A strong water shot rinses away stubborn stains and detergent residue.' },
	{ title: 'Save time, wash more', text: 'The 18 kg drum fits big items like a king-size duvet in a single load and washes it in 36 minutes*, so large volumes move quickly.' },
	{ title: 'Interior drum light', text: 'A built-in light lets customers see every item inside the drum, so nothing is left behind and unloading is quick.' },
	{ title: 'Safe, efficient, durable', text: 'The inverter direct-drive motor attaches straight to the drum, with no belt to wear out. VRT+ vibration control detects and reduces vibration across spin speeds and load sizes*.' },
	{ title: 'Keeps the washer clean', text: 'A detergent-free cleaning cycle soaks, pulses and spins to cut dirt and odor-causing bacteria. A water jet clears the door frame, and the machine tells you when it is due.' },
	{ title: 'Dryer drum that lasts', text: 'The dryer drum is stainless steel and heat-resistant. Unlike coated or plastic drums, it is built to resist chipping, scratching, rust and discoloration.' },
	{ title: 'Dryer alerts that help prevent breakdowns', text: 'A lint filter alert reminds you to clear the filter. A vent sensor watches the air duct and tells you when it needs cleaning, so the dryer keeps performing.' },
	{ title: 'Payment ready', text: 'Works with coin, card, RFID, QR code and credit card payment systems, set up for how your laundry runs. Payment systems and coin exchangers are sold separately.' },
	{ title: 'Connects to your other systems', text: 'You can add a third-party auto-dosing detergent system. If you already use management software, Samsung provides product protocol information to help connect it.' },
	{ title: 'Fit more in less space', text: 'Install side by side, or stack a matching dryer on top of the washer to save floor space. Stacking needs Samsung’s top installation kit (SKK-BC) and display kit (SKK-CC1).' },
];
const machines = [
	{
		img: washer,
		alt: 'Black Samsung 18 kg professional washer, front and angled views',
		title: '18 kg professional washer',
		model: 'WF18FG940CGVTC',
		highlights: ['Super Speed: 18 kg capacity, washes in 36 min*', 'Excellent durability: 30,000-cycle test for main parts', 'Bubble technology: bubble-powered washing'],
		spec: [
			['Capacity', '18 kg'],
			['Cycle time', '36 min'],
			['Body color', 'Black Caviar'],
			['Door color', 'Deep Charcoal'],
			['Panel display', 'LED'],
			['Drum type', 'Swirl Drum'],
			['Drum volume', '158 L'],
			['Dimensions (W x H x D)', '762 x 1,083 x 826 mm'],
			['Weight', '121 kg'],
			['Power consumption', '800 W'],
			['Power supply', '230 V / 60 Hz'],
			['Spin speed', '800 to 1,200 RPM'],
			['Inverter', 'Inverter (DD Motor)'],
			['Wi-Fi', 'Embedded'],
			['Mobile app and software', 'Open API for integration'],
			['Durability test', '30,000 cycles (main parts)'],
			['Installation dimensions', 'Depth with door open: 1,480 mm. Allow 150 mm clearance from the rear wall.'],
		],
	},
	{
		img: dryer,
		alt: 'Black Samsung 14 kg professional gas dryer, front and angled views',
		title: '14 kg professional gas dryer',
		model: 'DV14FG94GCGVST',
		highlights: ['Super Speed: 14 kg capacity, dries in 45 min', 'Flexible installation: reversible door to suit your space', 'User friendly: easy-to-use controller'],
		spec: [
			['Capacity', '14 kg'],
			['Cycle time', '45 min'],
			['Body color', 'Black Caviar'],
			['Door color', 'Deep Charcoal'],
			['Panel display', 'LED'],
			['Reversible door', 'Yes'],
			['Drum volume', '269 L'],
			['Dimensions (W x H x D)', '762 x 1,083 x 813 mm'],
			['Weight', '74 kg'],
			['Power consumption', '350 W'],
			['Power supply', '230 V / 60 Hz'],
			['Heating', 'LPG, 22,000 BTU'],
			['Inverter', 'Inverter (DD Motor)'],
			['Wi-Fi', 'Embedded'],
			['Mobile app and software', 'Open API for integration'],
			['Durability test', '30,000 cycles (main parts)'],
			['Installation dimensions', 'Depth with door open: 1,467 mm. Allow 150 mm clearance from the rear wall.'],
		],
	},
];
---

<Layout
	title="Samsung Professional Washers and Dryers | TeamG Venturez"
	description="Samsung professional washers and gas dryers, available through us as an authorized dealer in Calabarzon."
>
	<header class="page-head">
		<Image class="brandmark" src={samsung} alt="Samsung Professional Laundry" height={80} />
		<h1>Samsung professional laundry equipment from an authorized dealer in Calabarzon.</h1>
		<p>
			When you buy from us, the same team installs and services your machines.
		</p>
	</header>

	<section class="band" aria-labelledby="line">
		<h2 id="line">A washer and dryer, built to work as a pair.</h2>
		<div class="machines">
			{
				machines.map((m) => (
					<article>
						<figure class="photo">
							<Image src={m.img} alt={m.alt} widths={[420, 640, 900]} sizes="(min-width: 900px) 34rem, 92vw" />
						</figure>
						<Image class="brandmark sm" src={samsung} alt="Samsung Professional Laundry" height={60} />
						<h3>{m.title}</h3>
						<p class="model">Model {m.model}</p>
						<ul class="hl">
							{m.highlights.map((h) => <li>{h}</li>)}
						</ul>
						<dl>
							{m.spec.map(([k, v]) => <div><dt>{k}</dt><dd>{v}</dd></div>)}
						</dl>
					</article>
				))
			}
		</div>
		<p class="note">
			*Based on Samsung internal testing using a Normal cycle. Individual results may vary with actual load contents. Payment systems and coin exchangers are sold separately. Product images are for illustration. Specifications, prices and availability are estimates only and may be changed by TeamG Venturez without prior notice. Message us to confirm the current models and pricing.
		</p>
		<a class="btn" href={contact}>Ask about models and availability</a>
	</section>

	<section class="band" aria-labelledby="lpg">
		<h2 id="lpg">Our dryer runs on LPG, and we plan the setup with you.</h2>
		<p>
			The 14 kg professional dryer is a gas dryer that uses LPG. Our basic installation prepares the gas line,
			the dryer exhaust and ducting, the water supply, drainage and electrical connections, with leak testing
			and commissioning. You arrange the LPG tank, supply and regulator with an LPG provider. We confirm every
			requirement for your space during the free site visit.
		</p>
		<a class="btn" href={`${base}/services`}>See what installation covers</a>
	</section>

	<section class="band" aria-labelledby="feat">
		<Image class="brandmark" src={samsung} alt="Samsung Professional Laundry" height={80} />
		<h2 id="feat">Features that help a laundry business run smoothly.</h2>
		<ul class="rows">
			{
				features.map((f) => (
					<li>
						<h3>{f.title}</h3>
						<p>{f.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="band" aria-labelledby="why">
		<h2 id="why">Why we recommend Samsung professional equipment.</h2>
		<ul class="rows">
			{
				why.map((w) => (
					<li>
						<h3>{w.title}</h3>
						<p>{w.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="band split" aria-labelledby="fit">
		<div>
			<h2 id="fit">Stack your machines to save floor space.</h2>
			<p>
				Washers and dryers can be installed side by side or stacked. Stacking saves floor space, which helps in a shop space, hotel or BnB. Stacking requires Samsung’s top installation kit (SKK-BC) and display kit (SKK-CC1); we confirm them in your plan and quote. We will plan the layout, machine count and utilities with you before we install.
			</p>
			<a class="btn" href={contact}>Plan your layout with us</a>
		</div>
		<figure class="photo">
			<Image
				src={stackRow}
				alt="Four stacked pairs of black Samsung professional washers and dryers"
				widths={[480, 720, 1000]}
				sizes="(min-width: 900px) 34rem, 92vw"
			/>
			<figcaption>Image shown for illustration.</figcaption>
		</figure>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="prod-close">
			<div class="container">
				<h2 id="prod-close">Not sure which machines fit your space and volume?</h2>
				<a class="btn" href={contact}>Get a quote</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.brandmark {
		display: block;
		height: 2.75rem;
		width: auto;
		margin-bottom: 1.25rem;
		mix-blend-mode: multiply;
	}
	.brandmark.sm {
		height: 2rem;
		margin: 1.25rem 0 0.25rem;
	}
	.hl {
		list-style: none;
		margin: 0 0 1rem;
		padding: 0;
	}
	.hl li {
		padding: 0.4rem 0;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.machines {
		display: grid;
		gap: 3rem;
		margin-block: 2rem 1.5rem;
	}
	@media (min-width: 900px) {
		.machines {
			grid-template-columns: 1fr 1fr;
			gap: 4rem;
		}
	}
	.machines .photo :global(img) {
		aspect-ratio: 1 / 1;
		object-fit: contain;
		background: #fff;
		box-shadow: none;
		border: 1px solid var(--border);
	}
	.machines h3 {
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		margin: 1.25rem 0 0.5rem;
	}
	.model {
		margin: 0 0 0.75rem;
		color: var(--muted);
		font-size: 0.9rem;
	}
	.machines dl {
		margin: 0;
	}
	.machines dl > div {
		display: grid;
		grid-template-columns: 10rem 1fr;
		gap: 1rem;
		padding-block: 0.55rem;
		border-top: 1px solid var(--border);
	}
	.machines dt {
		font-weight: 600;
		font-size: 0.95rem;
	}
	.machines dd {
		margin: 0;
		color: var(--muted);
	}
	.note {
		font-size: 0.9rem;
		color: var(--muted);
	}
</style>
