---
import Layout from '../layouts/Layout.astro';
import { Image } from 'astro:assets';
import stackRow from '../assets/images/stack-row.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const perSet = 240000;
const utility = 200000;
const peso = (n: number) => `₱${n.toLocaleString('en-PH')}`;
const sizes = [
	{ sets: 2, wall: '1.52 m', wash: 40, dry: 32, kg: 448 },
	{ sets: 3, wall: '2.29 m', wash: 60, dry: 48, kg: 672 },
	{ sets: 4, wall: '3.05 m', wash: 80, dry: 64, kg: 896 },
	{ sets: 5, wall: '3.81 m', wash: 100, dry: 80, kg: 1120 },
];
// Shares of the theoretical dry-cycle ceiling shown in the sales tool. Scenario levels, not claims about any shop.
const scenarios = [
	{ name: 'A quiet day', note: 'a quarter of your dry cycles', share: 0.25 },
	{ name: 'A steady day', note: 'half of your dry cycles', share: 0.5 },
	{ name: 'A busy day', note: 'three quarters of your dry cycles', share: 0.75 },
];
const hospitality = {
	promise: 'Your own laundry inside your hotel, BnB or inn. Best if you own or manage one.',
	items: [
		'Laundry layout planned for your property',
		'Construction coordinated with your equipment plan',
		'Samsung equipment installed and maintained by our team',
		'Business consultation for running laundry in-house',
	],
};
---

<Layout
	title="Laundry Packages in Calabarzon | TeamG Venturez"
	description="Samsung laundry packages from 2 to 5 washer and dryer sets, from ₱480,000 for 2 sets (₱240,000 per set), with basic installation included. Free site visit."
>
	<header class="page-head">
		<h1>Choose a package that fits your space.</h1>
		<p>
			Samsung professional laundry packages from an authorized dealer in Calabarzon. Start small with 2 sets and
			expand later as your business grows. Your site visit and layout assessment are free, with no obligation.
		</p>
	</header>

	<section class="band" aria-labelledby="sets">
		<h2 id="sets">Equipment packages, starting at {peso(perSet)} per set</h2>
		<p class="lede">
			One set is one 18 kg washer and one 14 kg gas dryer. Basic installation is included in every package. Utility
			work, if your site needs it, is extra: from about {peso(utility)}.
		</p>
		<figure class="machines">
			<Image
				src={stackRow}
				alt="Rows of black Samsung professional washers and dryers stacked in pairs"
				widths={[480, 720, 1000]}
				sizes="(min-width: 960px) 70vw, 92vw"
			/>
			<figcaption>Samsung professional washers and dryers, stacked in pairs. Image shown for illustration.</figcaption>
		</figure>
		<div class="paths sizes">
			{
				sizes.map((p) => (
					<article>
						<h3>{p.sets} sets</h3>
						<p class="price">Starting at {peso(p.sets * perSet)}</p>
						<ul>
							<li>Equipment width: {p.wall}</li>
							<li>
								Per 12-hour day: {p.wash} wash and {p.dry} dry cycles, up to {p.kg} kg dry
							</li>
						</ul>
						<a class="btn" href={`${contact}?for=start&package=${p.sets}`}>
							Ask about {p.sets} sets
						</a>
					</article>
				))
			}
		</div>

		<h3 class="sub">What the price covers</h3>
		<ul class="cover">
			<li>
				<strong>Included:</strong> the Samsung equipment and basic installation: water and drainage connections,
				electrical connections for the washer and dryer, the gas dryer connection and leak test, dryer exhaust and
				ducting, and testing, commissioning, basic training and handover.
			</li>
			<li>
				<strong>If your site needs it:</strong> basic utility additions, from about {peso(utility)}, for the
				electrical, plumbing and ducting work needed to commission the equipment. For example, 2 sets at {
					peso(2 * perSet)
				} plus {peso(utility)} comes to about {peso(2 * perSet + utility)}. The site visit tells us whether you need
				it.
			</li>
			<li>
				<strong>Not included:</strong> civil works and structural changes, major electrical upgrades, building
				permits and government fees, and the LPG tank, supply and regulator.
			</li>
		</ul>
		<p class="note">
			The figures here are starting points. Your written quotation confirms the final figures after the site visit.
		</p>
		<details class="fine">
			<summary>How we count capacity</summary>
			<p>
				Wash and dry cycles are theoretical machine cycles, based on a 12-hour day with no gaps between loads. The
				number of completed wash-and-dry loads you get depends on load size, handling time and dryer capacity. The
				equipment width is the equipment only. Allow extra space for installation and service access, and we confirm
				clearances at your site visit.
			</p>
		</details>
	</section>

	<section class="band" aria-labelledby="calc-title" id="sales">
		<h2 id="calc-title">See what your sales could look like.</h2>
		<p class="lede">
			Tell us what you plan to charge per load and we will show the sales your machines could bring in. The figures
			come from your own price, so please use what you expect to charge in your area.
		</p>
		<noscript>
			<p class="note">
				This tool needs JavaScript. <a href={`${contact}?for=start`}>Message us</a> and we will walk you through your
				numbers.
			</p>
		</noscript>
		<div class="calc" id="calc-tool" hidden>
			<form class="calc-form" novalidate>
				<div class="field">
					<label for="c-sets">Package</label>
					<select id="c-sets">
						{
							sizes.map((p) => (
								<option value={p.sets} data-dry={p.dry} data-price={p.sets * perSet}>
									{p.sets} sets
								</option>
							))
						}
					</select>
				</div>
				<div class="field">
					<label for="c-price">Your price per load (₱)</label>
					<input id="c-price" type="number" inputmode="decimal" min="0" step="any" placeholder="Your price per load" />
				</div>
				<div class="field">
					<label for="c-days">Days open per month</label>
					<input id="c-days" type="number" inputmode="numeric" min="1" max="31" step="1" value="30" />
				</div>
			</form>
			<div aria-live="polite">
				<p class="calc-hint" id="calc-hint">Enter your price per load to see the figures.</p>
				<div id="calc-out" hidden>
					<p class="calc-pkg">
						<strong id="calc-pkg">2 sets:</strong> <span id="calc-pkg-price"></span>
					</p>
					<ul class="scen">
						{
							scenarios.map((s) => (
								<li data-share={s.share}>
									<p class="scen-name">
										{s.name} <span>{s.note}</span>
									</p>
									<dl class="scen-nums">
										<div>
											<dt>Finished loads a day</dt>
											<dd data-out="loads" />
										</div>
										<div>
											<dt>Sales a day</dt>
											<dd data-out="day" />
										</div>
										<div>
											<dt>Sales a month</dt>
											<dd data-out="month" />
										</div>
									</dl>
								</li>
							))
						}
					</ul>
				</div>
			</div>
			<p class="note">
				How we work this out: one finished load is counted as one dry cycle, because the dryer is the slower step, and
				we show a quarter, half and three quarters of the dry cycles your package can run in a 12-hour day. Your real
				results depend on your customers, load sizes and handling time. These are sales, not profit: LPG, water,
				electricity, rent, staff, detergent and permits come out of your sales, and they differ from site to site.
			</p>
			<p class="more">
				<a id="calc-cta" data-track="quote" data-base={`${contact}?for=start&package=`} href={`${contact}?for=start`}>
					Message us and we will walk you through your numbers
				</a>
			</p>
		</div>
	</section>

	<section class="band" aria-labelledby="hosp">
		<h2 id="hosp">For hotels, BnBs and inns</h2>
		<p class="lede">{hospitality.promise}</p>
		<ul class="cover">
			{hospitality.items.map((i) => <li>{i}</li>)}
		</ul>
		<p class="more"><a data-track="quote" href={`${contact}?for=hotel`}>Plan my in-house laundry</a></p>
	</section>

	<section class="band" aria-labelledby="sup">
		<h2 id="sup">After-sales support</h2>
		<p class="lede">
			Your equipment comes with a 2-year warranty and free preventive maintenance. For warranty claims, repairs and
			service visits, you deal with us, not with several companies. To request service, call, text or message us, or
			use the form.
		</p>
		<p class="more"><a data-track="quote" href={`${contact}?for=service`}>Request service</a></p>
	</section>

	<section class="band" aria-labelledby="upg">
		<h2 id="upg">Already running a laundry?</h2>
		<p class="lede">
			We can add machines, review your layout and take care of installation and ongoing maintenance for the laundry
			you already run.
		</p>
		<p class="more"><a data-track="quote" href={`${contact}?for=upgrade`}>Plan my upgrade</a></p>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="pk-close">
			<div class="container">
				<h2 id="pk-close">Not sure which package fits? Tell us your plan.</h2>
				<a class="btn" href={contact}>Get a quote</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.paths {
		display: grid;
		gap: 3rem;
	}
	@media (min-width: 900px) {
		.paths.sizes {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1200px) {
		.paths.sizes {
			grid-template-columns: repeat(4, 1fr);
			gap: 2rem;
		}
	}
	article {
		display: flex;
		flex-direction: column;
		border-top: 2px solid var(--text);
		padding-top: 1.5rem;
	}
	h3 {
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.03em;
		font-size: 1.5rem;
		line-height: 1.1;
		margin: 0 0 0.5rem;
	}
	.price {
		font-size: 1.0625rem;
		font-weight: 700;
		margin: 0 0 1.25rem;
	}
	ul {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
	}
	li {
		padding-block: 0.7rem;
		border-top: 1px solid var(--border);
	}
	article .btn {
		margin-top: auto;
		align-self: flex-start;
	}
	.lede,
	li {
		text-wrap: pretty;
	}
	.lede {
		max-width: 65ch;
		margin: 0 0 2rem;
	}
	.machines {
		margin: 0 0 3rem;
	}
	.machines img {
		display: block;
		width: 100%;
		height: auto;
		aspect-ratio: 16 / 9;
		object-fit: cover;
		border-radius: 0.9rem;
	}
	@media (min-width: 900px) {
		.machines img {
			aspect-ratio: 16 / 6;
		}
	}
	.machines figcaption {
		font-size: 0.95rem;
		color: var(--muted);
		margin-top: 0.5rem;
	}
	.sub {
		margin: 3rem 0 0.5rem;
	}
	.cover {
		margin: 0;
		max-width: 65ch;
	}
	.note {
		margin-top: 2rem;
		color: var(--muted);
		font-size: 0.95rem;
		max-width: 65ch;
	}
	.fine {
		margin-top: 1rem;
		color: var(--muted);
		font-size: 0.95rem;
		max-width: 65ch;
	}
	.fine summary {
		cursor: pointer;
		font-weight: 600;
		color: var(--accent);
	}
	.fine p {
		margin: 0.75rem 0 0;
	}
	.more {
		margin: 0;
	}
	/* Sales tool */
	.calc-form {
		display: grid;
		gap: 1.25rem;
		max-width: 52rem;
		margin-bottom: 1.75rem;
	}
	@media (min-width: 700px) {
		.calc-form {
			grid-template-columns: 1fr 1.4fr 1fr;
		}
	}
	.field {
		display: grid;
		gap: 0.4rem;
		align-content: start;
	}
	label {
		font-weight: 600;
		font-size: 0.95rem;
	}
	input,
	select {
		font: inherit;
		font-size: 1.0625rem;
		color: var(--text);
		background: #fff;
		border: 1px solid var(--muted);
		border-radius: 0.5rem;
		padding: 0.75rem 0.9rem;
		width: 100%;
	}
	input::placeholder {
		color: color-mix(in srgb, var(--muted) 85%, #fff);
	}
	input:focus-visible,
	select:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 1px;
		border-color: var(--accent);
	}
	.calc-hint {
		margin: 0 0 1.75rem;
		color: var(--muted);
	}
	.calc-pkg {
		margin: 0 0 0.75rem;
		font-weight: 600;
	}
	.calc-pkg span {
		font-weight: 400;
		color: var(--muted);
	}
	.scen {
		max-width: 52rem;
		margin: 0 0 1.75rem;
		border-bottom: 1px solid var(--border);
	}
	.scen-name {
		margin: 0 0 0.5rem;
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.02em;
		font-size: 1.15rem;
	}
	.scen-name span {
		font-family: 'Hanken Grotesk', system-ui, sans-serif;
		font-weight: 400;
		font-size: 0.95rem;
		letter-spacing: 0;
		color: var(--muted);
		margin-left: 0.5rem;
	}
	.scen-nums {
		display: grid;
		gap: 0.25rem 1.5rem;
		margin: 0;
	}
	.scen-nums div {
		display: flex;
		justify-content: space-between;
		align-items: baseline;
		gap: 1rem;
	}
	.scen-nums dt {
		color: var(--muted);
		font-size: 0.95rem;
	}
	.scen-nums dd {
		margin: 0;
		font-family: var(--display);
		font-weight: 700;
		font-size: 1.25rem;
		letter-spacing: -0.02em;
	}
	@media (min-width: 560px) {
		.scen-nums {
			grid-template-columns: repeat(3, 1fr);
		}
		.scen-nums div {
			display: grid;
			gap: 0.1rem;
		}
	}
</style>

<script>
	const tool = document.getElementById('calc-tool');
	if (tool) {
		const sets = document.getElementById('c-sets') as HTMLSelectElement;
		const price = document.getElementById('c-price') as HTMLInputElement;
		const days = document.getElementById('c-days') as HTMLInputElement;
		const hint = document.getElementById('calc-hint') as HTMLElement;
		const out = document.getElementById('calc-out') as HTMLElement;
		const pkg = document.getElementById('calc-pkg') as HTMLElement;
		const pkgPrice = document.getElementById('calc-pkg-price') as HTMLElement;
		const cta = document.getElementById('calc-cta') as HTMLAnchorElement;
		const peso = (n: number) => `₱${Math.round(n).toLocaleString('en-PH')}`;
		let tracked = false;

		const update = () => {
			const opt = sets.selectedOptions[0];
			const dry = Number(opt.dataset.dry);
			const p = parseFloat(price.value);
			const d = parseInt(days.value, 10);
			cta.href = `${cta.dataset.base}${sets.value}`;
			if (!(p > 0)) {
				out.hidden = true;
				hint.hidden = false;
				hint.textContent = 'Enter your price per load to see the figures.';
				return;
			}
			if (!(d >= 1 && d <= 31)) {
				out.hidden = true;
				hint.hidden = false;
				hint.textContent = 'Enter the days you will be open in a month, from 1 to 31.';
				return;
			}
			hint.hidden = true;
			out.hidden = false;
			pkg.textContent = `${sets.value} sets:`;
			pkgPrice.textContent = `Package from ${peso(Number(opt.dataset.price))}, with basic installation`;
			out.querySelectorAll<HTMLElement>('li[data-share]').forEach((li) => {
				const loads = Math.round(dry * Number(li.dataset.share));
				li.querySelector('[data-out="loads"]')!.textContent = String(loads);
				li.querySelector('[data-out="day"]')!.textContent = peso(loads * p);
				li.querySelector('[data-out="month"]')!.textContent = peso(loads * p * d);
			});
			if (!tracked) {
				tracked = true;
				(window as any).tgTrack?.('sales_tool_used', { sets: sets.value, page: location.pathname });
			}
		};

		tool.hidden = false;
		tool.querySelector('form')!.addEventListener('submit', (e) => e.preventDefault());
		[sets, price, days].forEach((el) => el.addEventListener('input', update));
		update();
	}
</script>
