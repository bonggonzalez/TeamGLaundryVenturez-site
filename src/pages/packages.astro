---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const perSet = 240000;
const utility = 200000;
const peso = (n: number) => `₱${n.toLocaleString('en-PH')}`;
const sizes = [
	{ sets: 2, wall: '1.52 m', wash: 40, dry: 32, kg: 448 },
	{ sets: 3, wall: '2.29 m', wash: 60, dry: 48, kg: 672 },
	{ sets: 4, wall: '3.05 m', wash: 80, dry: 64, kg: 896 },
	{ sets: 5, wall: '3.81 m', wash: 100, dry: 80, kg: 1120 },
];
const hospitality = {
	name: 'Hotels, BnBs and inns',
	promise: 'Your own laundry inside your hotel, BnB or inn.',
	best: 'Best if you own or manage a hotel, BnB or inn.',
	items: [
		'Laundry layout planned for your property',
		'Construction coordinated with your equipment plan',
		'Samsung equipment installed and maintained by our team',
		'Business consultation for running laundry in-house',
	],
};
---

<Layout
	title="Laundry Packages in Calabarzon | TeamG Venturez"
	description="Samsung laundry packages from 2 to 5 washer and dryer sets, starting at ₱240,000 per set. Estimates only; basic installation included. Free site visit."
>
	<header class="page-head">
		<h1>Choose a package that fits your space.</h1>
		<p>
			Start small with 2 sets and expand later as your business grows. Every package includes basic installation,
			and your site visit and layout assessment are free, with no obligation.
		</p>
	</header>

	<section class="band" aria-labelledby="sets">
		<h2 id="sets">Equipment packages, starting at {peso(perSet)} per set</h2>
		<div class="paths sizes">
			{
				sizes.map((p) => (
					<article>
						<h3>{p.sets} sets</h3>
						<p class="promise">Starting at {peso(p.sets * perSet)}</p>
						<p class="best">One set is one 18 kg washer and one 14 kg gas dryer.</p>
						<ul>
							<li>Equipment footprint: {p.wall} of wall width</li>
<li>Theoretical capacity: {p.wash} wash cycles and {p.dry} dry cycles over a 12-hour day</li>
<li>Up to {p.kg} kg of dry capacity a day</li>
<li>Basic installation included</li>
<li>Utility work, if your site needs it: from about {peso(utility)}, so about {peso(p.sets * perSet + utility)} in total</li>
</ul>
<a class="btn" href={`${contact}?for=start&package=${p.sets}`}>Ask about {p.sets} sets</a>
					</article>
				))
			}
		</div>
		<h3 class="sub">What the price covers</h3>
<ul class="cover">
<li><strong>Included:</strong> the Samsung equipment and basic installation. This means water and drainage connections, electrical connections for the washer and dryer, the gas dryer connection and leak test, dryer exhaust and ducting, and testing, commissioning, basic training and handover.</li>
<li><strong>If your site needs it:</strong> basic utility additions, from about {peso(utility)}. These cover the electrical, plumbing and ducting work needed to commission the equipment. For example, 2 sets at {peso(2 * perSet)} plus utility work of {peso(utility)} comes to about {peso(2 * perSet + utility)}. The site visit tells us whether you need it.</li>
<li><strong>Not included:</strong> civil works and structural changes, major electrical upgrades, building permits and government fees, and the LPG tank, supply and regulator.</li>
</ul>
<p class="note">
Wash and dry cycles are theoretical machine cycles, based on a 12-hour day with no gaps between loads. The number of completed wash-and-dry loads you get depends on load size, handling time and dryer capacity. The footprint is the width of the equipment only. Allow extra space for installation and service access, and we confirm clearances at your site visit.
</p>
		<p class="note">
			Prices, capacity figures and timelines are estimates only. TeamG Venturez may change them without prior notice.
			Your written quotation confirms the final figures after the site visit.
		</p>
	</section>

	<section class="band" aria-labelledby="hosp">
		<h2 id="hosp">For hotels, BnBs and inns</h2>
		<div class="paths">
			<article>
				<h3>{hospitality.name}</h3>
				<p class="promise">{hospitality.promise}</p>
				<p class="best">{hospitality.best}</p>
				<ul>
					{hospitality.items.map((i) => <li>{i}</li>)}
				</ul>
				<a class="btn" href={`${contact}?for=hotel`}>Plan my in-house laundry</a>
			</article>
		</div>
	</section>

	<section class="band" aria-labelledby="sup">
<h2 id="sup">After-sales support</h2>
<p>Your equipment comes with a 2-year warranty and free preventive maintenance. For warranty claims, repairs and service visits, you deal with us, not with several companies. To request service, call, text or message us, or use the form.</p>
<a class="btn" href={`${contact}?for=service`}>Request service</a>
</section>

<section class="band" aria-labelledby="upg">
		<h2 id="upg">Already running a laundry?</h2>
		<p>We can add machines, review your layout and take care of installation and ongoing maintenance for the laundry you already run.</p>
		<a class="btn" href={`${contact}?for=upgrade`}>Plan my upgrade</a>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="pk-close">
			<div class="container">
				<h2 id="pk-close">Not sure which package fits? Tell us your plan.</h2>
				<a class="btn" href={contact}>Get a quote</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.paths {
		display: grid;
		gap: 3rem;
	}
	@media (min-width: 900px) {
		.paths {
			grid-template-columns: repeat(3, 1fr);
			gap: 3rem;
		}
		.paths.sizes {
			grid-template-columns: repeat(2, 1fr);
		}
	}
	@media (min-width: 1200px) {
		.paths.sizes {
			grid-template-columns: repeat(4, 1fr);
			gap: 2rem;
		}
	}
	article {
		display: flex;
		flex-direction: column;
		border-top: 2px solid var(--text);
		padding-top: 1.5rem;
	}
	h3 {
		font-family: var(--display);
		font-weight: 800;
		letter-spacing: -0.03em;
		font-size: 1.9rem;
		line-height: 1.1;
		margin: 0 0 0.5rem;
	}
	.promise {
		color: var(--muted);
		margin: 0 0 0.5rem;
	}
	.best {
		font-size: 0.9rem;
		font-weight: 600;
		margin: 0 0 1.25rem;
	}
	@media (min-width: 900px) {
		.promise {
			min-height: 3.2em;
		}
	}
	ul {
		list-style: none;
		margin: 0 0 1.75rem;
		padding: 0;
	}
	li {
		padding-block: 0.7rem;
		border-top: 1px solid var(--border);
	}
	article .btn {
		margin-top: auto;
		align-self: flex-start;
	}
	.sub {
font-size: 1.3rem;
margin: 2.5rem 0 0.5rem;
}
.cover {
margin: 0;
max-width: 52rem;
}
.note {
		margin-top: 2.5rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
</style>
