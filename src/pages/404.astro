---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<Layout
	title="Page not found | TeamG Venturez"
	description="We could not find that page. Go back to the TeamG Venturez home page or ask us for a quote."
>
	<header class="page-head">
		<h1>We could not find that page.</h1>
		<p>The link may be old or mistyped. Try one of these, or message us and we will help.</p>
	</header>
	<section class="band" aria-label="Where to go next">
		<p class="links">
			<a class="btn" href={`${base}/`}>Go to the home page</a>
			<a href={`${base}/packages`}>See packages</a>
			<a href={`${base}/products`}>See products</a>
			<a href={`${base}/contact`}>Get a quote</a>
		</p>
	</section>
</Layout>

<style>
	.links {
		display: flex;
		flex-wrap: wrap;
		gap: 1rem 1.5rem;
		align-items: center;
		margin: 0;
	}
</style>
