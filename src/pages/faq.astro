---
import Layout from '../layouts/Layout.astro';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const faqs = [
	{ q: 'Who is TeamG Venturez?', a: 'We are the exclusive Samsung laundry equipment distributor in Calabarzon. We also design, build, install and maintain laundry operations.' },
	{ q: 'What areas do you cover?', a: 'Calabarzon: Cavite, Laguna, Batangas, Rizal and Quezon.' },
	{ q: 'Do you only sell machines?', a: 'No. We help with design, construction, installation and maintenance. We also set up point-of-sale systems and offer business and marketing consultation.' },
	{ q: 'Can hotels and BnBs work with you?', a: 'Yes, we are glad to. We help hotels, BnBs, inns and resorts set up a laundry inside their own property.' },
	{ q: 'What do I need to start a laundry business?', a: 'A plan, a space and equipment. We help with all three: layout design, construction, Samsung equipment, point-of-sale and business guidance. Tell us where you are and we will advise on the next step.' },
	{ q: 'Do you install and maintain the equipment?', a: 'Yes, we install the equipment we distribute and look after it with ongoing maintenance.' },
	{ q: 'What is Samsung Care+?', a: 'Samsung Care+ is a service package for Samsung Professional Laundry that covers maintenance and inspection. Ask us what it includes and how to add it to your equipment.' },
	{ q: 'Can I add my own auto-dosing detergent system?', a: 'Yes. You can connect a third-party auto-dosing detergent system to the washers.' },
	{ q: 'Can the machines work with my existing management software?', a: 'Yes. Samsung provides product protocol information and assistance to integrate with your current software. Tell us what you use and we will help with the next step.' },
	{ q: 'What payment systems can I use?', a: 'Coin, card, RFID, QR code and credit card systems. Payment systems and coin exchangers are sold separately.' },
	{ q: 'Can I stack the dryer on the washer?', a: 'Yes. Stacking needs Samsung’s top installation kit (SKK-BC) and display kit (SKK-CC1). We confirm what you need when we plan your layout.' },
	{ q: 'Can I buy just the equipment?', a: 'Yes, you can buy just the equipment from us. Tell us what you need and we will confirm models and availability.' },
	{ q: 'How much does it cost?', a: 'The price depends on three things: your floor area, how many machines you run, and the services you add. Tell us those and we will give you a quote.' },
	{ q: 'Which models are available?', a: 'Speak to us for current models and availability.' },
	{ q: 'How long does a project take?', a: 'It depends on the scope. We will discuss timing once we know your plan.' },
	{ q: 'Do you offer financing or a warranty?', a: 'Speak to us. We will confirm terms during your consultation.' },
	{ q: 'How do I get a quote?', a: 'Send us a request. Tell us your space, your plan and what you want to run. Pricing depends on your project and is set after a consultation.' },
];
const faqSchema = {
	'@context': 'https://schema.org',
	'@type': 'FAQPage',
	mainEntity: faqs.map((f) => ({
		'@type': 'Question',
		name: f.q,
		acceptedAnswer: { '@type': 'Answer', text: f.a },
	})),
};
---

<Layout
	title="FAQ | TeamG Venturez"
	description="Answers to common questions about our services, coverage in Calabarzon, hotels and BnBs, equipment, installation, maintenance and getting a quote."
>
	<script slot="head" type="application/ld+json" set:html={JSON.stringify(faqSchema)} />
	<header class="page-head">
		<h1>Questions, answered.</h1>
		<p>Straight answers to what people usually ask us. If an answer depends on your plan, we will tell you and help you work it out.</p>
	</header>

	<section class="band" aria-labelledby="faq-list">
		<h2 id="faq-list" class="sr">Frequently asked questions</h2>
		<div class="faq">
			{
				faqs.map((f) => (
					<details>
						<summary>{f.q}</summary>
						<p>{f.a}</p>
					</details>
				))
			}
		</div>
	</section>

	<Fragment slot="after">
		<section class="closing" aria-labelledby="faq-close">
			<div class="container">
				<h2 id="faq-close">Still have a question? Ask us.</h2>
				<a class="btn" href={contact}>Get a quote</a>
			</div>
		</section>
	</Fragment>
</Layout>

<style>
	.sr {
		position: absolute;
		width: 1px;
		height: 1px;
		overflow: hidden;
		clip-path: inset(50%);
		white-space: nowrap;
	}
	.faq {
		max-width: 52rem;
	}
	details {
		border-top: 1px solid var(--border);
	}
	details:last-child {
		border-bottom: 1px solid var(--border);
	}
	summary {
		cursor: pointer;
		list-style: none;
		display: flex;
		justify-content: space-between;
		gap: 1rem;
		padding-block: 1.25rem;
		font-family: var(--display);
		font-weight: 700;
		letter-spacing: -0.02em;
		font-size: 1.3rem;
		line-height: 1.3;
	}
	summary::-webkit-details-marker {
		display: none;
	}
	summary::after {
		content: '+';
		font-weight: 400;
		color: var(--muted);
		transition: rotate 0.25s cubic-bezier(0.16, 1, 0.3, 1);
	}
	details[open] summary::after {
		rotate: 45deg;
	}
	details p {
		margin: 0 0 1.5rem;
		color: var(--muted);
		max-width: 60ch;
	}
</style>
