---
import { Image } from 'astro:assets';
import Layout from '../layouts/Layout.astro';
import { site } from '../config/site';
import stackRow from '../assets/images/stack-row.jpg';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const contact = `${base}/contact`;
const provinces = ['Cavite', 'Laguna', 'Batangas', 'Rizal', 'Quezon'];
const audiences = [
	{ title: 'Aspiring laundry entrepreneurs', text: 'If you want to start a laundry negosyo, we bring the equipment and help you plan it.' },
	{ title: 'Existing laundry owners', text: 'If you already run a laundry, we help you upgrade your equipment and the way you operate.' },
	{ title: 'Hotels, BnBs and other hospitality owners', text: 'If you want laundry inside your own property, we help you set it up.' },
];
---

<Layout
	title="About | TeamG Venturez"
	description="We are TeamG Venturez, an authorized Samsung laundry equipment dealer in Calabarzon, here to help you plan, build and run your laundry."
>
	<header class="page-head">
		<h1>The team behind Samsung laundry in Calabarzon.</h1>
		<p>We help you build a complete laundry business, with the machines as one part of it.</p>
	</header>

	<section class="band split" aria-labelledby="who">
		<div>
			<h2 id="who">Who we are</h2>
			<p>
				We are TeamG Venturez, an authorized Samsung laundry equipment dealer in Calabarzon,
				Philippines.
			</p>
			<p>
				We are your partner from the first sketch to opening day and beyond: design, construction, installation and maintenance, point-of-sale systems, and business and marketing advice.
			</p>
			<a class="btn" href={contact}>Get a quote</a>
		</div>
		<figure class="photo">
			<Image
				src={stackRow}
				alt="Rows of black Samsung professional washers and dryers"
				widths={[480, 720, 1000]}
				sizes="(min-width: 900px) 34rem, 92vw"
			/>
			<figcaption>Image shown for illustration.</figcaption>
		</figure>
	</section>

	<section class="band" aria-labelledby="clients">
		<h2 id="clients">Who we work with</h2>
		<ul class="rows">
			{
				audiences.map((a) => (
					<li>
						<h3>{a.title}</h3>
						<p>{a.text}</p>
					</li>
				))
			}
		</ul>
	</section>

	<section class="band" aria-labelledby="area">
		<h2 id="area">Where we operate</h2>
		<p>We serve Calabarzon: Cavite, Laguna, Batangas, Rizal and Quezon.</p>
		<p>Visit our showroom at {site.addressDisplay}.</p>
		<p><a href={`${base}/services`}>See our services</a> or <a href={`${base}/products`}>our products</a>.</p>
	</section>
</Layout>
