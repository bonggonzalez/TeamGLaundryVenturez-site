---
import Layout from '../layouts/Layout.astro';
import ContactIcons from '../components/ContactIcons.astro';
import { site } from '../config/site';
const EMAIL = site.email;
const PHONE = site.phoneDisplay;
const PHONE_LOCAL = site.phoneLocal;
// Set PUBLIC_FORM_ENDPOINT (see .env.example) to post requests to a form service.
// While empty, the form opens the visitor's email app addressed to EMAIL.
const FORM_ENDPOINT = site.formEndpoint;
const provinces = site.provinces;
const roles = [
	{ key: 'start', label: 'Starting a laundry business' },
	{ key: 'upgrade', label: 'Upgrading my laundry' },
	{ key: 'hotel', label: 'Hotel or BnB laundry' },
	{ key: 'other', label: 'Something else' },
];
const interests = [
	'Samsung equipment',
	'Design and construction',
	'Installation',
	'Maintenance',
	'Point-of-sale systems',
	'Business and marketing consultation',
	'Not sure yet',
];
---

<Layout
	title="Get a Quote | TeamG Venturez"
	description="Talk to us about starting or upgrading a laundry operation in Calabarzon. Get a quote by form, phone, text or email."
>
	<header class="page-head">
		<h1>Let's plan your laundry.</h1>
		<p>
			Starting, upgrading or adding laundry to your property? Tell us your plan and we will help with the next step.
		</p>
	</header>

	<section class="band" aria-labelledby="channels">
		<h2 id="channels">Reach us directly</h2>
		<ContactIcons size="lg" class="channels" />
		<p class="area">Visit our showroom at {site.addressDisplay}. We serve {provinces.join(', ')}.</p>
	</section>

	<section class="band" aria-labelledby="inquiry">
		<div class="form-wrap">
			<div class="form-intro">
				<h2 id="inquiry">Get a quote</h2>
				<p>
					Share a few details. We will follow up to discuss your plan and the equipment that fits, and we will arrange your free site visit. After the visit you receive a written quote, and then a contract once you are ready. Prices and timelines are estimates only and may be changed by TeamG Venturez without prior notice.
				</p>
			</div>
			<form id="inquiry-form" action={FORM_ENDPOINT || undefined} method="post" novalidate>
				<div class="row two">
					<label><span>First name <span class="req">(required)</span></span>
						<input name="first_name" autocomplete="given-name" required />
					</label>
					<label>Last name
						<input name="last_name" autocomplete="family-name" />
					</label>
				</div>
				<div class="row two">
					<label><span>Mobile number <span class="req">(required)</span></span>
						<input name="mobile" type="tel" autocomplete="tel" required />
					</label>
					<label>Email
						<input name="email" type="email" autocomplete="email" />
					</label>
				</div>
				<div class="row two">
					<label>What best describes you?
						<select name="role" id="role">
							{roles.map((r) => <option value={r.key}>{r.label}</option>)}
						</select>
					</label>
					<label>Location
						<select name="province">
							{provinces.map((p) => <option>{p}</option>)}
						</select>
					</label>
				</div>
				<label>What do you need?
					<select name="interest">
						{interests.map((i) => <option>{i}</option>)}
					</select>
				</label>
				<label>Your space or plan
					<textarea name="message" rows="4" placeholder="For example: floor area in square meters, number of machines, target opening date"></textarea>
				</label>
				<button class="btn" type="submit">Send my request</button>
				<p class="privacy">We use your details only to reply to your request, in line with the Data Privacy Act of 2012.</p>
				<p id="form-status" role="status" aria-live="polite"></p>
			</form>
		</div>
	</section>
</Layout>

<style>
	.channels {
		margin-top: 1.5rem;
	}
	.area {
		margin: 1.25rem 0 0;
	}
	.form-wrap {
		display: grid;
		gap: 2rem;
	}
	@media (min-width: 960px) {
		.form-wrap {
			grid-template-columns: 1fr 1.4fr;
			gap: 4rem;
		}
	}
	form {
		display: grid;
		gap: 1.25rem;
	}
	.row.two {
		display: grid;
		gap: 1.25rem;
	}
	@media (min-width: 640px) {
		.row.two {
			grid-template-columns: 1fr 1fr;
		}
	}
	label {
		display: grid;
		gap: 0.4rem;
		font-weight: 600;
		font-size: 0.95rem;
	}
	.req {
		font-weight: 400;
		color: var(--muted);
	}
	input,
	select,
	textarea {
		font: inherit;
		font-weight: 400;
		color: var(--text);
		background: #fff;
		border: 1px solid #9db4d3;
		border-radius: 0.5rem;
		padding: 0.75rem 0.9rem;
		width: 100%;
	}
	input::placeholder,
	textarea::placeholder {
		color: #5f6f84;
	}
	input:focus-visible,
	select:focus-visible,
	textarea:focus-visible {
		outline: 3px solid var(--accent);
		outline-offset: 1px;
		border-color: var(--accent);
	}
	input[aria-invalid='true'] {
		border-color: #b3261e;
	}
	.privacy {
		font-size: 0.85rem;
		color: var(--muted);
		margin: 0.75rem 0 0;
	}
	#form-status {
		margin: 0;
		min-height: 1.5em;
		color: var(--muted);
	}
	form .btn {
		justify-self: start;
	}
</style>

<script define:vars={{ endpoint: FORM_ENDPOINT, email: EMAIL, phone: PHONE }}>
	const params = new URLSearchParams(location.search);
	const role = document.getElementById('role');
	const wanted = params.get('for');
	if (wanted && role && [...role.options].some((o) => o.value === wanted)) role.value = wanted;

	const form = document.getElementById('inquiry-form');
	const status = document.getElementById('form-status');
	form.addEventListener('submit', async (e) => {
		e.preventDefault();
		let ok = true;
		for (const name of ['first_name', 'mobile']) {
			const el = form.elements[name];
			const bad = !el.value.trim();
			el.setAttribute('aria-invalid', bad ? 'true' : 'false');
			if (bad && ok) el.focus();
			if (bad) ok = false;
		}
		if (!ok) {
			status.textContent = 'Add your first name and mobile number to continue.';
			return;
		}
		if (!endpoint) {
			const f = form.elements;
			const lines = [
				`Name: ${f.first_name.value} ${f.last_name.value}`.trim(),
				`Mobile: ${f.mobile.value}`,
				`Email: ${f.email.value}`,
				`Description: ${f.role.selectedOptions[0].text}`,
				`Location: ${f.province.value}`,
				`Need: ${f.interest.value}`,
				'',
				f.message.value,
			];
			const href = `mailto:${email}?subject=${encodeURIComponent('Quote request')}&body=${encodeURIComponent(lines.join('\n'))}`;
			status.textContent = `Opening your email app. You can also email ${email} or call or text ${phone}.`;
			if (window.tgTrack) window.tgTrack('generate_lead', { method: 'email_fallback' });
			location.href = href;
			return;
		}
		status.textContent = 'Sending...';
		try {
			const res = await fetch(endpoint, {
				method: 'POST',
				headers: { Accept: 'application/json' },
				body: new FormData(form),
			});
			if (!res.ok) throw new Error('bad status');
			if (window.tgTrack) window.tgTrack('generate_lead', { method: 'form' });
			form.reset();
			status.textContent = 'Salamat po! We have your request and will be in touch.';
		} catch {
			status.textContent = `Your request did not send. Please try again, or call or text ${phone}, or email ${email}.`;
		}
	});
</script>
