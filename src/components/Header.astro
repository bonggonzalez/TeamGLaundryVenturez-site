---
const links = [
	{ href: '/', label: 'Home' },
	{ href: '/services', label: 'Services' },
	{ href: '/about', label: 'About' },
	{ href: '/contact', label: 'Contact' },
];
const path = Astro.url.pathname;
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href="/">Team G Laundry Venturez</a>
		<nav aria-label="Main">
			<ul>
				{
					links.map((l) => (
						<li>
							<a href={l.href} aria-current={path === l.href ? 'page' : undefined}>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
	</div>
</header>

<style>
	.site-header {
		border-bottom: 1px solid var(--border);
		background: var(--bg);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		justify-content: space-between;
		gap: 0.5rem 1.5rem;
		padding-block: 1rem;
	}
	.brand {
		font-weight: 700;
		font-size: 1.15rem;
		color: var(--text);
		text-decoration: none;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		padding-block: 0.25rem;
		border-bottom: 2px solid transparent;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
</style>
