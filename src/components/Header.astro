---
import { Image } from 'astro:assets';
import logo from '../assets/images/teamg-venturez-logo.png';
import samsung from '../assets/images/samsung-logo.png';
import { navLinks as links } from './nav-links';
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
const norm = (p: string) => p.replace(/\/$/, '') || '/';
const current = norm(Astro.url.pathname);
---

<header class="site-header">
	<div class="container bar">
		<a class="brand" href={`${base}/`} aria-label="TeamG Venturez with Samsung Professional Laundry, home">
			<Image src={logo} alt="TeamG Venturez" height={72} loading="eager" />
			<span class="x" aria-hidden="true"></span>
			<Image class="sam" src={samsung} alt="Samsung Professional Laundry" height={72} loading="eager" />
		</a>
		<button class="menu-toggle" type="button" aria-expanded="false" aria-controls="site-nav">Menu</button>
		<nav id="site-nav" aria-label="Main">
			<ul>
				{
					links.map((l) => (
						<li>
							<a
								href={`${base}${l.href}`}
								aria-current={current === norm(`${base}${l.href}`) ? 'page' : undefined}
							>
								{l.label}
							</a>
						</li>
					))
				}
			</ul>
		</nav>
		<a class="cta" href={`${base}/contact`}>Get a quote</a>
	</div>
</header>

<style>
	.site-header {
		background: #fff;
		border-bottom: 1px solid var(--border);
	}
	.bar {
		display: flex;
		flex-wrap: wrap;
		align-items: center;
		gap: 0.5rem 1.5rem;
		padding-block: 0.75rem;
	}
	.brand {
		display: flex;
		align-items: center;
		gap: 0.75rem;
		margin-right: auto;
		line-height: 0;
	}
	.brand .x {
		width: 1px;
		height: 1.5rem;
		background: var(--border);
	}
	.brand :global(img) {
		height: 2.1rem;
		width: auto;
		mix-blend-mode: multiply;
	}
	nav {
		order: 3;
		width: 100%;
	}
	ul {
		display: flex;
		flex-wrap: wrap;
		gap: 0.25rem 1.25rem;
		margin: 0;
		padding: 0;
		list-style: none;
	}
	nav a {
		color: var(--muted);
		text-decoration: none;
		font-weight: 500;
		display: inline-block;
		padding-block: 0.6rem 0.4rem;
		border-bottom: 2px solid transparent;
	}
	nav a:hover,
	nav a[aria-current='page'] {
		color: var(--text);
		border-bottom-color: var(--accent);
	}
	.cta {
		background: var(--accent);
		color: #fff;
		font-weight: 600;
		font-size: 0.95rem;
		text-decoration: none;
		padding: 0.6rem 1.1rem;
		border-radius: 0.5rem;
		transition: background 0.2s cubic-bezier(0.16, 1, 0.3, 1);
	}
	.cta:hover {
		background: var(--accent-strong);
	}
	.menu-toggle {
		display: none;
	}
	/* Phones: the sticky bar at the bottom carries the quote button, and the nav folds into a Menu button. */
	@media (max-width: 759px) {
		.cta {
			display: none;
		}
		.bar.js .menu-toggle {
			display: inline-flex;
			align-items: center;
			min-height: 2.75rem;
			padding-inline: 1.1rem;
			border: 1px solid var(--border);
			border-radius: 0.5rem;
			background: #fff;
			color: var(--text);
			font: inherit;
			font-weight: 600;
			cursor: pointer;
		}
		.bar.js nav:not(.open) {
			display: none;
		}
	}
	@media (min-width: 820px) {
		.site-header {
			position: sticky;
			top: 0;
			z-index: 10;
			background: rgba(255, 255, 255, 0.92);
			backdrop-filter: blur(8px);
		}
		nav {
			order: 0;
			width: auto;
		}
		.brand {
			margin-right: 0;
		}
		.brand :global(img) {
			height: 2.5rem;
		}
		.brand .x {
			height: 1.75rem;
			margin-inline: 0.25rem;
		}
		.bar {
			gap: 0.5rem 2.75rem;
		}
		.cta {
			margin-left: auto;
		}
	}
</style>

<script>
	document.querySelectorAll<HTMLElement>('.site-header .bar').forEach((bar) => {
		const button = bar.querySelector<HTMLButtonElement>('.menu-toggle');
		const nav = bar.querySelector<HTMLElement>('nav');
		if (!button || !nav) return;
		bar.classList.add('js');
		const setOpen = (open: boolean) => {
			nav.classList.toggle('open', open);
			button.setAttribute('aria-expanded', String(open));
			button.textContent = open ? 'Close' : 'Menu';
		};
		button.addEventListener('click', () => setOpen(!nav.classList.contains('open')));
		bar.addEventListener('keydown', (e) => {
			if (e.key === 'Escape' && nav.classList.contains('open')) {
				setOpen(false);
				button.focus();
			}
		});
	});
</script>
