---
import MapLink from './MapLink.astro';
import { Image } from 'astro:assets';
import logo from '../assets/images/teamg-venturez-logo.png';
import samsung from '../assets/images/samsung-logo.png';
import { navLinks, serviceLinks } from './nav-links';
import ContactIcons from './ContactIcons.astro';
import { site } from '../config/site';
const year = new Date().getFullYear();
const base = import.meta.env.BASE_URL.replace(/\/$/, '');
---

<footer class="site-footer">
	<div class="container grid">
		<div>
			<div class="lockup"><Image class="flogo" src={logo} alt="TeamG Venturez" height={72} /><Image class="fsam" src={samsung} alt="Samsung Professional Laundry" height={72} /></div>
			<p>
				Authorized Samsung Professional Laundry dealer in Calabarzon, Philippines. We design,
				build, equip and maintain commercial laundry operations.
			</p>
		</div>
		<nav aria-label="Quick links">
			<h2>Quick links</h2>
			<ul>
				{navLinks.map((l) => <li><a href={`${base}${l.href}`}>{l.label}</a></li>)}
			</ul>
		</nav>
		<div>
			<h2>What we do</h2>
			<ul>
				{serviceLinks.map((s) => <li><a href={`${base}/services`}>{s}</a></li>)}
			</ul>
		</div>
		<div>
			<h2>Contact</h2>
			<ContactIcons size="sm" />
			<p>Visit our showroom: {site.addressDisplay}.</p>
			<p><MapLink /></p>
			<p>Serving Cavite, Laguna, Batangas, Rizal and Quezon.</p>
			<p><a href={`${base}/contact`}>Get a quote</a></p>
		</div>
	</div>
	<div class="container">
		<p class="legal">
			TeamG Venturez is an independent company and an authorized dealer of Samsung Professional Laundry equipment.
			We are a separate company from Samsung Electronics Co., Ltd. and its Philippine distributor. Agreements are
			between you and TeamG Venturez. Samsung and Samsung Professional Laundry are trademarks of Samsung Electronics Co., Ltd.
		</p>
		<p class="legal">
			Prices, capacity figures and timelines on this site are estimates only. TeamG Venturez may change them without prior notice.
		</p>
		<p class="copy">&copy; {year} TeamG Venturez. All rights reserved.</p>
	</div>
</footer>

<style>
	.site-footer {
		border-top: 1px solid var(--border);
		padding-block: 2.5rem 2rem;
		color: var(--muted);
		font-size: 0.95rem;
	}
	.grid {
		display: grid;
		gap: 2rem;
		grid-template-columns: repeat(auto-fit, minmax(13rem, 1fr));
	}
	h2 {
		font-family: var(--display);
		font-size: 1rem;
		color: var(--text);
		margin: 0 0 0.6rem;
	}
	ul {
		list-style: none;
		margin: 0;
		padding: 0;
	}
	li {
		margin-bottom: 0.3rem;
	}
	a {
		color: var(--muted);
	}
	a:hover {
		color: var(--accent);
	}
	p {
		margin: 0 0 0.5rem;
	}
	.lockup {
		display: flex;
		align-items: center;
		gap: 1rem;
		margin-bottom: 0.9rem;
	}
	.site-footer :global(.fsam) {
		height: 2.25rem;
		width: auto;
		mix-blend-mode: multiply;
	}
	.site-footer :global(.flogo) {
		height: 2.25rem;
		width: auto;
		mix-blend-mode: multiply;
	}
	.legal {
		margin: 0 0 0.75rem;
		font-size: 0.8rem;
		line-height: 1.5;
		opacity: 0.75;
		max-width: 60rem;
	}
	.copy {
		margin-top: 2rem;
		font-size: 0.85rem;
	}
</style>
