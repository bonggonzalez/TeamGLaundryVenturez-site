# Copy to .env (local) or set in your host's environment settings. All optional.
# Anything left empty is not rendered.

# Form service URL that accepts a POST (for example a Formspree or Web3Forms endpoint).
# While empty, the quote form falls back to opening the visitor's email app.
PUBLIC_FORM_ENDPOINT=

# Tracking
PUBLIC_GA_ID=            # Google Analytics 4 ID, e.g. G-XXXXXXXXXX
PUBLIC_META_PIXEL_ID=    # Meta (Facebook) pixel ID

# Chat channels (international format for numbers)
# Viber and WhatsApp default to the main phone number; set these only to use a different one.
PUBLIC_VIBER_NUMBER=     # e.g. +639173098138
PUBLIC_WHATSAPP_NUMBER=  # e.g. +639173098138
PUBLIC_MESSENGER_PAGE=   # Defaults to 61596817145519 (m.me/61596817145519); set only to override
PUBLIC_FACEBOOK_URL=     # Defaults to the TeamG Venturez page; set only to override
